---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Editor from "../../components/Editor.astro";
import CodeCard from "../../components/CodeCard.astro";
import { CHEATSHEET } from "../../data/cheatsheet";
import { GITHUB_URL } from "../../data/site";

const renderInlineCode = (body: string) => body.replace(/`([^`]+)`/g, "<code>$1</code>");
const SYNTAX_URL = `${GITHUB_URL}/blob/main/documentation/SYNTAX.md`;
---

<Base
  title="Playground — curios"
  description="Write and run curios in the browser — it typechecks and compiles to WebAssembly right here, nothing leaves your browser."
>
  <div class="page">
    <Nav crumb="playground" />

    <div class="main">
      <div class="intro">
        <h1 class="h-serif">Playground</h1>
        <p>Pick an example or write your own curios — it typechecks and compiles to WebAssembly right here, nothing leaves your browser.</p>
      </div>

      <Editor />

      <div class="cheat-section">
        <div class="cheat-intro">
          <div class="eyebrow">// the cheat sheet</div>
          <h2 class="h-serif">The whole language, one scroll.</h2>
          <p>
            Curios is a small language &mdash; this really is most of it. Lifted straight from the <a href={SYNTAX_URL} target="_blank" rel="noopener">language reference</a>; when the two disagree, that's a conformance bug in one of them.
          </p>
        </div>

        <div class="cheat-grid">
          {
            CHEATSHEET.map((card) => (
              <CodeCard filename={card.filename}>
                <div class="cheat-blurb" set:html={renderInlineCode(card.blurb)} />
                <pre class="cheat-code" set:html={card.lines.join("\n")} />
              </CodeCard>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px clamp(20px, 4vw, 64px) 110px;
  }
  .intro {
    margin-bottom: 28px;
  }
  .intro h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    margin: 0 0 10px;
  }
  .intro p {
    font-size: 15.5px;
    color: var(--fg-dimmer);
    margin: 0;
    max-width: 560px;
  }

  .cheat-section {
    margin-top: 90px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }
  .cheat-intro h2 {
    font-size: clamp(26px, 3vw, 34px);
    margin: 0 0 12px;
  }
  .cheat-intro p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg-dimmer);
    max-width: 640px;
    margin: 0;
    text-wrap: pretty;
  }
  .cheat-intro a {
    color: var(--accent);
  }

  .cheat-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  .cheat-blurb {
    padding: 16px 22px 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-dimmer);
    text-wrap: pretty;
  }
  .cheat-blurb :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 1px 5px;
  }
  .cheat-code {
    margin: 0;
    padding: 14px 22px 20px;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--fg);
    white-space: pre;
    overflow-x: auto;
  }
  .cheat-code :global(.kw) {
    color: oklch(74% 0.18 306);
  }
  .cheat-code :global(.ty) {
    color: oklch(82% 0.09 300);
  }
  .cheat-code :global(.cm) {
    color: var(--fg-faint);
  }
  .cheat-code :global(.str) {
    color: var(--green);
  }

  @media (max-width: 860px) {
    .cheat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
