---
import AppShell from "../../layouts/AppShell.astro";
import Toolbar from "../../components/Toolbar.astro";
import Editor from "../../components/Editor.astro";
import OutputPane from "../../components/OutputPane.astro";
import CheatsheetRail from "../../components/CheatsheetRail.astro";
import { EXAMPLES } from "../../data/examples";

const keys = Object.keys(EXAMPLES);
const defaultKey = keys[0];

const OUTPUT_PLACEHOLDER = "Nothing has been printed. Go break something — it just might show up here.";
---

<AppShell title="Playground · Curios">
  <div class="frame">
    <Toolbar scroll>
      <span class="label">EXAMPLES</span>
      {
        keys.map((key) => (
          <button class:list={["chip", key === defaultKey && "chip--on"]} aria-pressed={key === defaultKey} data-example={key}>
            {EXAMPLES[key].label}
          </button>
        ))
      }
    </Toolbar>

    <Editor />

    <Toolbar class="actions">
      <button class="btn btn--primary btn--sm run" data-run>Run</button>
      <span class="status">
        <span class="trail" data-trail>ready</span>
        <span class="step" data-step></span>
      </span>
      <button class="btn btn--sm push toggle" data-rail-toggle aria-label="Cheatsheet">Cheatsheet</button>
    </Toolbar>

    <OutputPane placeholder={OUTPUT_PLACEHOLDER} />
  </div>

  <CheatsheetRail />
</AppShell>

<style>
  /* The frame fills whatever the header leaves and hands its slack to the editor. Nothing here scrolls; the editor and the output pane scroll inside themselves, which is what keeps the toolbars where you left them. */
  .frame {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* The trail can run to four steps; on a narrow bar it truncates rather than push the cheatsheet toggle out of the frame — and the buttons on either side hold their width, so it is only ever the numbers that give. Both are built from the one --sm recipe and stand the same height without either being handed one. */
  .frame :global(.actions) .btn {
    flex: none;
  }

  /* Run swaps its label mid-run, so its width is pinned above the longer of the two: "Running…" measures 59px in Geist at this size and weight, plus 40px of padding and the border. Left to size itself the button would more than double the moment it was clicked and shove the breadcrumb sideways just as the breadcrumb started saying something.

     A play triangle is not what the "›" is standing in for: Geist's latin subset carries no "▸", so a label wearing one would be part fallback face, and a fallback face brings its own metrics — the button lost height when the text swapped to an all-Geist "Running…". The guillemet is in the face, so the label stays one font, one line box, one height. */
  .run {
    justify-content: center;
    min-width: 104px;
  }

  /* The sigil belongs to the waiting button, not to the running one: a run that is under way is not pointing anywhere. It rides as a pseudo-element so the script that swaps the word never has to carry it around, and it leaves on `:disabled`, which is the exact state a run puts the button in — the label and the sigil change on the same event without either knowing about the other. The 10px between it and the word is the button's own gap, the same one the cheatsheet toggle uses at the far end of the bar. */
  .run::after {
    content: "›";
  }

  .run:disabled::after {
    content: none;
  }

  /* The cheatsheet's own heading, lifted onto the button that opens it: Faustina italic at the 21px the rail's own h2 wears, the same weight, and the same single word. No sigil — the word is doing the work, and the rail's "›" is what sends it back. Opening the rail should feel like the heading grew into a panel rather than like a new thing appeared.

     It carries the rail head's surface too, which on this bar is nearly the toolbar's own colour, so what reads is the writing rather than a button. That is the point: there is one call to action here and it is Run.

     The padding is what keeps the two the same height. Run is 13px of Geist in a 1.3em line box plus 9px either side; this is 21px of Faustina held to a line box of 1, so 7px either side lands both on 37px. The size is the rail heading's own, and a fixed one on purpose: set to the height the bar leaves it, the word came out twice the heading it is quoting.

     The negative margin is optical alignment. Run's fill is visible, so its block edge is what the eye measures against the bar's 20px padding; this button's fill is not, so the eye measures the word — and the word sat 40px in, its own padding on top of the bar's, reading as a wider margin than Run's. Pulling the box out by exactly its own padding puts the word where Run's block edge is, and spends the padding on a click target that reaches into the gutter instead of on empty space. */
  .toggle {
    padding: 7px 20px;
    margin-right: -20px;
    font-family: var(--display);
    font-style: italic;
    font-size: 21px;
    line-height: 1;
    background: var(--raise);
    color: var(--fg);
  }

  /* The hover contract the whole site keeps: go amber. */
  .toggle:hover {
    color: var(--accent);
  }

  /* The mirror of the "›" the rail closes with: that one points at where the panel goes, this one at where it comes from. It is a flex item of the button like the word beside it, so the 10px between them is the button's own gap — the same one Run keeps to its own sigil at the other end of the bar.

     Faustina carries both guillemets, so this stays in the same face as the word rather than dragging in a fallback for one glyph — the mistake Run's label made with a play triangle.

     The aria-label is what keeps the button's accessible name to the word: generated content counts toward the name, and a screen reader has no use for a piece of punctuation. */
  .toggle::before {
    content: "‹";
  }

  .status {
    min-width: 0;
    display: flex;
    font-family: var(--mono);
    font-size: var(--ms-chip);
  }

  /* The steps already paid for. These are what gives when the bar runs short — they clip from the right, so a cramped window keeps the waits you have been sitting through and loses the tail of the trail rather than the step in play, which never shrinks. */
  .trail {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--fg-faint);
  }

  /* The end of the breadcrumb: whatever is happening now, or — once nothing is — how it went wrong. It never shrinks, and it is empty on a run that worked, because the trail has already said everything there is to say about one of those. */
  .step {
    flex: none;
  }

  .step[data-tone="working"] {
    color: var(--accent);
  }

  /* Green is the whole verdict, now that nothing sits beside the output to give a second one: a line that reached "ran" is a program that compiled, ran, and printed whatever is in the pane below. */
  .step[data-tone="ok"] {
    color: var(--ok);
  }

  .step[data-tone="error"] {
    color: var(--err);
  }

  /* The size doubles as a link to the module itself, and it keeps whatever colour the crumb is wearing rather than taking the site's accent, hover included: the tone of this line is a verdict, and a green "ran" that turned orange halfway through would be reporting something it does not mean. An underline is the whole of what marks it — offset far enough to clear the descenders it runs under.

     Global because the anchor is minted by the script rather than written in the template above, so it never carries the scope attribute a scoped selector would look for. */
  .status :global(a),
  .status :global(a):hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The separator belongs to the step, and only when there is a trail in front of it to be separated from — the first step of a run leads the line rather than trailing a dot. It needs `pre` to keep its own spaces: generated content sits at the start of the step's line box, and a leading space there is collapsible whitespace, which the line box strips. The dot would otherwise arrive wearing only its right-hand space. */
  .trail:not(:empty) + .step:not(:empty)::before {
    content: " · ";
    white-space: pre;
    color: var(--fg-faint);
  }

  /* Below the breakpoint AppShell has let the body scroll, so the editor takes a fixed share of the screen and the pane sits under it at whatever height its output wants. The action bar sticks, one bar's height down so it parks under the sticky header rather than sliding beneath it: Run has to stay in reach while you scroll down to read what it produced. */
  @media (max-width: 720px) {
    .frame :global(.editor) {
      flex: none;
      height: 55dvh;
    }

    .frame :global(.actions) {
      position: sticky;
      top: var(--bar);
      z-index: 10;
      background: var(--raise);
    }

    /* No room for the timings between two thumb-sized buttons, and no good way to wrap four phases under them either. On a phone the pane carries the outcome by itself — it turns red and says what went wrong — and the numbers are a desktop luxury. */
    .status {
      display: none;
    }
  }
</style>

<script is:inline type="module" define:vars={{ EXAMPLES, defaultKey }}>
  // The compiler is a published asset rather than a source module, so this script stays inline and imports it at runtime. If the bundle was never fetched, the loader reports a load-phase failure and the output pane says so — the page still works, it just cannot compile.
  import { compileAndReport } from "/curios/loader.js";

  const source = document.querySelector("[data-source]");
  const gutter = document.querySelector("[data-gutter]");
  const runButton = document.querySelector("[data-run]");
  const trail = document.querySelector("[data-trail]");
  const stepLine = document.querySelector("[data-step]");
  const chips = [...document.querySelectorAll("[data-example]")];
  const output = document.querySelector("[data-output]");

  let running = false;

  function renderGutter() {
    const lines = source.value.split("\n").length;
    gutter.textContent = Array.from({ length: lines }, (_, index) => index + 1).join("\n");
  }

  function setOutput(text, tone) {
    const empty = !text;
    output.textContent = empty ? output.dataset.placeholder : text;
    output.classList.toggle("empty", empty);
    output.classList.toggle("error", !empty && tone === "error");
  }

  // Every step the compiler goes through, in the three forms the line needs: the one it wears while it is happening, the one it leaves behind when it finishes, and the plain one it leaves behind when it doesn't. The past tense is reserved for the step that earned it — "compiled" is a claim about the program, and a compile that was refused has no business making it.
  const STEPS = {
    load: { doing: "downloading…", done: (ms) => `downloaded ${ms.toFixed(0)}ms`, stopped: (ms) => `download ${ms.toFixed(0)}ms` },
    warm: { doing: "initializing…", done: (ms) => `initialized ${ms.toFixed(0)}ms`, stopped: (ms) => `init ${ms.toFixed(0)}ms` },
    compile: { doing: "compiling…", done: (ms) => `compiled ${ms.toFixed(1)}ms`, stopped: (ms) => `compile ${ms.toFixed(1)}ms` },
    run: { doing: "running…", done: moduleCrumb, stopped: (ms) => `run ${ms.toFixed(1)}ms` },
  };

  // Whether the compiler is already in the worker, which decides what the first step of the next run will be. The worker's own events settle it either way; this only spares the line from starting blank.
  let loaded = false;

  // The module from the last successful run, and the crumb that offers it. The URL lives exactly as long as that crumb is on the line: minted when the bytes arrive, dropped the moment the line is cleared, so a session of runs leaves one blob alive rather than one per run.
  let moduleUrl = null;
  let moduleLink = null;

  function dropModule() {
    if (moduleUrl) URL.revokeObjectURL(moduleUrl);
    moduleUrl = null;
    moduleLink = null;
  }

  // Crumbs rather than a string, because one of them is a link. Both of these clear with an empty `replaceChildren` rather than an empty string: the separator between the trail and the step keys off `:empty`, and an empty text node is still a child.
  function setTrail(parts) {
    trail.replaceChildren();
    parts.forEach((part, index) => {
      if (index) trail.append(" · ");
      trail.append(part);
    });
  }

  function setStep(content, tone) {
    if (content) stepLine.replaceChildren(content);
    else stepLine.replaceChildren();
    stepLine.dataset.tone = tone ?? "";
  }

  // "ran 12.4kb of WebAssembly in 0.3ms", with the size standing in for the module it measures. The anchor is minted without an href and kept aside for the result to arm: the bytes only reach the page a moment after this is drawn, and until then there is nothing to hand over — an anchor with no href is inert and unstyled, which is the truth of that moment.
  function moduleCrumb(ms, bytes) {
    moduleLink = document.createElement("a");
    moduleLink.textContent = `${(bytes / 1024).toFixed(1)}kb of WebAssembly`;
    moduleLink.title = "Download the compiled module";

    const crumb = document.createElement("span");
    crumb.append("ran ", moduleLink, ` in ${ms.toFixed(1)}ms`);
    return crumb;
  }

  function clearOutput() {
    dropModule();
    setOutput("");
    setTrail(["ready"]);
    setStep("");
  }

  // Lit and pressed are the same fact: which example is in the buffer. Colour alone would leave a screen reader with thirteen identical buttons.
  function light(chip, on) {
    chip.classList.toggle("chip--on", on);
    chip.setAttribute("aria-pressed", String(on));
  }

  function pick(key) {
    source.value = EXAMPLES[key].code;
    renderGutter();
    chips.forEach((chip) => light(chip, chip.dataset.example === key));
    clearOutput();
  }

  // Editing detaches the buffer from whichever example it started as, so no chip stays lit: what is in the editor is no longer that file.
  source.addEventListener("input", () => {
    renderGutter();
    chips.forEach((chip) => light(chip, false));
  });

  source.addEventListener("scroll", () => {
    gutter.scrollTop = source.scrollTop;
  });

  chips.forEach((chip) => chip.addEventListener("click", () => pick(chip.dataset.example)));

  runButton.addEventListener("click", async () => {
    if (running) return;
    running = true;
    runButton.disabled = true;
    runButton.textContent = "Running…";
    // The last run's module goes with the last run's output: its crumb is about to be cleared off the line, and nothing else holds the URL.
    dropModule();
    setOutput("");

    // The line is a breadcrumb: each step names itself as it starts, then settles into a measurement and hands the end of the line to the next one. There is no separate success message at the end because none is needed — a line that reached "ran" is a program that compiled and ran, and it says so in more detail than "accepted" would, so that last crumb simply goes green and stands as the verdict.
    const done = [];
    let ran = null;
    setTrail([]);

    // Named here rather than waited for: spawning the worker and fetching its script takes long enough on a cold page to leave the line blank, and the first "begin" from the worker overwrites this the moment it lands, so guessing wrong costs nothing.
    setStep(loaded ? STEPS.compile.doing : STEPS.load.doing, "working");

    try {
      const result = await compileAndReport(source.value, ({ phase, step, ms, bytes }) => {
        if (phase === "begin") {
          setStep(STEPS[step].doing, "working");
          return;
        }
        // The run step is handed the size of the module it ran alongside its duration: with no second pane to state it, the breadcrumb is the only place the compiler's output gets measured — or offered.
        const crumb = STEPS[step].done(ms, bytes);
        if (step === "load") loaded = true;

        // The run is the last step there is, so its crumb stays where the outcome goes rather than falling back into the trail: green, unshrinkable, and holding the slot an error would otherwise have taken.
        if (step === "run") {
          ran = crumb;
          setStep(crumb, "ok");
          return;
        }

        done.push(crumb);
        setTrail(done);
        setStep("");
      });

      if (!result.ok) {
        setOutput(result.error, "error");
        // A compiler that never arrived has judged nothing, so the line says as much rather than laying the failure at the program's door.
        const unavailable = result.phase === "load";
        if (unavailable) loaded = false;

        // The step that failed still leaves its crumb. How long the compiler spent before refusing is worth as much as how long it spends accepting, and without this the commonest failure there is — a typo, on a page that is already warm — would put "error" on an otherwise empty line, which is the whole thing this line was built to stop doing. Only a failure that measured nothing skips it: if the worker never started, there is no duration to report and the verdict stands alone honestly.
        const failed = STEPS[result.phase];
        if (failed && result.ms > 0) {
          done.push(failed.stopped(result.ms));
          setTrail(done);
        }

        setStep(unavailable ? "compiler unavailable" : "error", "error");
        return;
      }

      // The bytes only travel with the result, so the crumb's link is armed here rather than where it was drawn — a few milliseconds of an anchor that does not lead anywhere, on a line nobody has had time to reach for yet.
      moduleUrl = URL.createObjectURL(new Blob([result.bytes], { type: "application/wasm" }));
      moduleLink.href = moduleUrl;
      moduleLink.download = "program.wasm";

      // stderr joins stdout, and the way the process ended joins both: the pane holds the transcript of the run, not a feed of one stream.
      const printed = [`${result.run.stdout}${result.run.stderr}`.trimEnd()];
      const trapped = Boolean(result.run.trap);
      if (trapped) printed.push(result.run.trap);
      else if (result.run.exitCode) printed.push(`Process exited with code ${result.run.exitCode}`);

      // A run that trapped is a failed run, and the whole transcript is coloured as one: whatever the program managed to print before it died is part of the failure rather than output standing on its own.
      setOutput(printed.filter(Boolean).join("\n"), trapped ? "error" : undefined);
      // A trap is the one outcome the crumbs cannot convey on their own. It is not a clean finish, so the run's crumb gives up the outcome slot and falls back into the trail — how long the program took to reach the trap is still worth reading — and the verdict takes its place.
      if (trapped) {
        done.push(ran);
        setTrail(done);
        setStep("error", "error");
      }
    } finally {
      running = false;
      runButton.disabled = false;
      runButton.textContent = "Run";
    }
  });

  pick(defaultKey);
</script>
