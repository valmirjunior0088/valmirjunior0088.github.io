---
import AppShell from "../../layouts/AppShell.astro";
import Toolbar from "../../components/Toolbar.astro";
import Editor from "../../components/Editor.astro";
import Splitter from "../../components/Splitter.astro";
import OutputPane from "../../components/OutputPane.astro";
import CheatsheetRail from "../../components/CheatsheetRail.astro";
import Label from "../../components/Label.astro";
import Chip from "../../components/Chip.astro";
import Button from "../../components/Button.astro";
import { EXAMPLES } from "../../data/examples";
import styles from "./playground.module.css";

const [first] = EXAMPLES;

const OUTPUT_PLACEHOLDER = "Nothing has been printed. Go break something — it just might show up here.";
---

<AppShell page="playground">
  <div class={styles.frame}>
    <Toolbar scroll>
      <Label>EXAMPLES</Label>
      {
        EXAMPLES.map(({ name }) => (
          <Chip pressed={name === first.name} data-example={name}>
            {name}.crs
          </Chip>
        ))
      }
    </Toolbar>

    <Editor class={styles.editor} />

    <Splitter class={styles.splitter} />

    <Toolbar class={styles.actions}>
      <Button variant="primary" size="sm" class={`${styles.control} ${styles.run}`} data-run>Run</Button>
      <span class={styles.status}>
        <span class={styles.trail} data-trail>ready</span>
        <span class={styles.step} data-step></span>
      </span>
      <Button variant="outline" size="sm" class={`${styles.control} ${styles.toggle}`} data-rail-toggle aria-label="Cheatsheet">Cheatsheet</Button>
    </Toolbar>

    <OutputPane class={styles.output} placeholder={OUTPUT_PLACEHOLDER} />
  </div>

  <CheatsheetRail />
</AppShell>

<script>
  import { EXAMPLES } from "../../data/examples";

  // What loader.js hands back. It is a published asset rather than a source module, so nothing checks this against it; it is written down here so the rest of the script is checked against something.
  type Step = "load" | "warm" | "compile" | "run";
  type PhaseEvent = { phase: "begin"; step: Step } | { phase: "end"; step: Step; ms: number; bytes?: number };
  type Report =
    | { ok: true; bytes: Uint8Array<ArrayBuffer>; run: { stdout: string; stderr: string; exitCode: number; trap?: string | null } }
    | { ok: false; phase: "load" | "compile" | "run" | "internal"; ms?: number; error: string };
  type Loader = { compileAndReport(source: string, onPhase: (event: PhaseEvent) => void): Promise<Report> };

  // The loader sits beside the compiler bundle scripts/fetch.sh downloads, and is fetched from where the site serves it, the first time Run is pressed. It is named through a variable, so the bundler leaves it alone rather than trying to pull a public file into the build, and imported as a full URL, because the dev server rewrites a root-relative import to ask for a module it will then refuse to serve out of public/. If the bundle was never fetched, the loader reports a load-phase failure and the pane says so: the page still works, it just cannot compile.
  const LOADER = "/curios/loader.js";
  let loader: Promise<Loader> | null = null;

  async function compileAndReport(text: string, onPhase: (event: PhaseEvent) => void): Promise<Report> {
    let module: Loader;
    try {
      loader ??= import(/* @vite-ignore */ new URL(LOADER, location.href).href);
      module = await loader;
    } catch (error) {
      loader = null;
      return { ok: false, phase: "load", error: `Couldn't reach ${LOADER}: ${error instanceof Error ? error.message : error}` };
    }
    return module.compileAndReport(text, onPhase);
  }

  // The examples' text, bundled with this script so a chip swaps its file in without a request — less the newline every file ends with, which would otherwise be a numbered empty line under the program.
  const SOURCES = import.meta.glob<string>("../../data/examples/*.crs", { query: "?raw", import: "default", eager: true });
  const sourceOf = (name: string) => (SOURCES[`../../data/examples/${name}.crs`] ?? "").replace(/\n$/, "");

  // Every element this drives is in the template above. One that has gone missing is a template edited out from under the script, and saying so at once beats a TypeError three clicks later.
  function element<T extends Element>(selector: string): T {
    const found = document.querySelector<T>(selector);
    if (!found) throw new Error(`playground: nothing matches ${selector}`);
    return found;
  }

  const source = element<HTMLTextAreaElement>("[data-source]");
  const gutter = element<HTMLElement>("[data-gutter]");
  const editor = element<HTMLElement>("[data-editor]");
  const splitter = element<HTMLElement>("[data-splitter]");
  const runButton = element<HTMLButtonElement>("[data-run]");
  const trail = element<HTMLElement>("[data-trail]");
  const stepLine = element<HTMLElement>("[data-step]");
  const output = element<HTMLElement>("[data-output]");
  const paint = element<HTMLElement>("[data-paint]");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-example]")];

  let running = false;

  // Every run takes a number, and clearing the line takes the next one. A run that finds the number has moved on was overtaken — an example picked while it was still compiling — and keeps quiet from then on, rather than writing the old program's output under the new program's name. It still finishes, because the compiler cannot be interrupted, and Run waits for it.
  let current = 0;

  function renderGutter() {
    const lines = source.value.split("\n").length;
    gutter.textContent = Array.from({ length: lines }, (_, index) => index + 1).join("\n");
  }

  // The editor's paint. Until the highlighter has loaded — it comes after the page, so it never holds it up — the paint shows the code plain, which keeps the transparent textarea readable from the first frame. The trailing newline gives a last empty line of the textarea a line in the paint to match.
  let paintCode: ((code: string) => string) | null = null;

  function renderPaint() {
    if (paintCode) paint.innerHTML = `${paintCode(source.value)}\n`;
    else paint.textContent = `${source.value}\n`;
  }

  import("../../lib/highlight")
    .then(({ highlight }) => {
      paintCode = highlight;
      renderPaint();
    })
    .catch(() => {});

  // Which the pane is showing — the placeholder, or something the run produced that went wrong — is said by attributes, which the pane's style reads.
  function setOutput(text: string, tone?: "error") {
    const empty = !text;
    output.textContent = empty ? (output.dataset.placeholder ?? "") : text;
    output.toggleAttribute("data-empty", empty);
    output.toggleAttribute("data-error", !empty && tone === "error");
  }

  // Every step the compiler goes through, in the two forms the line needs: the one it wears while it is happening, and the past tense it leaves behind once it has earned it. That past tense is a claim — "compiled" says the program is good — so a step that failed leaves no crumb at all and the verdict speaks for it instead. Each names what it acts on: the first two the compiler, arriving and waking up; the third the source, since by then the object is the program you wrote; and the fourth the WebAssembly that came of it — which is the truth of what happens here and the thing a bare "fetched" or "compiled" left you to guess.
  const STEPS: Record<Step, { doing: string; done: (ms: number, bytes?: number) => Node | string }> = {
    load: { doing: "fetching compiler…", done: (ms) => `fetched compiler in ${ms.toFixed(0)}ms` },
    warm: { doing: "warming compiler…", done: (ms) => `warmed compiler in ${ms.toFixed(0)}ms` },
    compile: { doing: "compiling source…", done: (ms) => `compiled source in ${ms.toFixed(1)}ms` },
    run: { doing: "running…", done: (ms, bytes) => moduleCrumb(ms, bytes ?? 0) },
  };

  // Whether the compiler is already in the worker, which decides what the first step of the next run will be. The worker's own events settle it either way; this only spares the line from starting blank.
  let loaded = false;

  // The module from the last successful run, and the crumb that offers it. The URL lives exactly as long as that crumb is on the line: minted when the bytes arrive, dropped the moment the line is cleared, so a session of runs leaves one blob alive rather than one per run.
  let moduleUrl: string | null = null;
  let moduleLink: HTMLAnchorElement | null = null;

  function dropModule() {
    if (moduleUrl) URL.revokeObjectURL(moduleUrl);
    moduleUrl = null;
    moduleLink = null;
  }

  // Crumbs rather than a string, because one of them is a link. Both of these clear with an empty `replaceChildren` rather than an empty string: the separator between the trail and the step keys off `:empty`, and an empty text node is still a child.
  function setTrail(parts: (Node | string)[]) {
    trail.replaceChildren();
    parts.forEach((part, index) => {
      if (index) trail.append(" · ");
      trail.append(part);
    });
  }

  function setStep(content: Node | string, tone?: "working" | "ok" | "error") {
    if (content) stepLine.replaceChildren(content);
    else stepLine.replaceChildren();
    stepLine.dataset.tone = tone ?? "";
  }

  // "ran 12.4kb of WebAssembly in 0.3ms", with the size standing in for the module it measures. The anchor is minted without an href and kept aside for the result to arm: the bytes only reach the page a moment after this is drawn, and until then there is nothing to hand over — an anchor with no href is inert and unstyled, which is the truth of that moment.
  function moduleCrumb(ms: number, bytes: number) {
    moduleLink = document.createElement("a");
    moduleLink.textContent = `${(bytes / 1024).toFixed(1)}kb of WebAssembly`;
    moduleLink.title = "Download the compiled module";

    const crumb = document.createElement("span");
    crumb.append("ran ", moduleLink, ` in ${ms.toFixed(1)}ms`);
    return crumb;
  }

  function clearOutput() {
    current++;
    dropModule();
    setOutput("");
    setTrail(["ready"]);
    setStep("");
  }

  // Lit and pressed are the same fact: which example is in the buffer. Colour alone would leave a screen reader with twelve identical buttons.
  function light(chip: HTMLButtonElement, on: boolean) {
    chip.setAttribute("aria-pressed", String(on));
  }

  function pick(name: string) {
    source.value = sourceOf(name);
    renderGutter();
    renderPaint();
    chips.forEach((chip) => light(chip, chip.dataset.example === name));
    clearOutput();
  }

  // Editing detaches the buffer from whichever example it started as, so no chip stays lit: what is in the editor is no longer that file.
  source.addEventListener("input", () => {
    renderGutter();
    renderPaint();
    chips.forEach((chip) => light(chip, false));
  });

  source.addEventListener("scroll", () => {
    gutter.scrollTop = source.scrollTop;
    paint.scrollTop = source.scrollTop;
    paint.scrollLeft = source.scrollLeft;
  });

  chips.forEach((chip) => chip.addEventListener("click", () => pick(chip.dataset.example ?? "")));

  // How tall the pane is, how much room it shares with the editor, and how far it can go either way: down to its own min-height, up until the editor is at its own. Both floors are read from the styles that set them rather than restated here.
  type Bounds = { height: number; room: number; min: number; max: number };

  function bounds(): Bounds {
    const height = output.getBoundingClientRect().height;
    const room = height + editor.getBoundingClientRect().height;
    const min = parseFloat(getComputedStyle(output).minHeight);
    return { height, room, min, max: room - parseFloat(getComputedStyle(editor).minHeight) };
  }

  // Both heights are set, not just the pane's: the editor's is what a window that changes size afterwards scales in proportion, so it has to be the editor you left rather than the one the page started with.
  function resize(height: number, { room, min, max }: Bounds) {
    const pane = Math.min(Math.max(height, min), max);
    output.style.setProperty("--output-height", `${pane}px`);
    editor.style.setProperty("--editor-height", `${room - pane}px`);
  }

  // The bounds are taken once, when the splitter is grabbed, so the pane stops dead at either end and starts moving again the moment the pointer comes back — rather than piling up a height the frame will not give it, to be paid off on the way back before anything moves. Capturing the pointer keeps the drag alive when it outruns the strip, and holding back the press keeps it from selecting the page on the way.
  let drag: (Bounds & { y: number }) | null = null;

  splitter.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    splitter.setPointerCapture(event.pointerId);
    splitter.toggleAttribute("data-dragging", true);
    drag = { y: event.clientY, ...bounds() };
  });

  splitter.addEventListener("pointermove", (event) => {
    if (drag) resize(drag.height + drag.y - event.clientY, drag);
  });

  // Releasing the pointer, cancelling it, and losing it all end here: capture is released implicitly on the first two.
  splitter.addEventListener("lostpointercapture", () => {
    splitter.toggleAttribute("data-dragging", false);
    drag = null;
  });

  // The splitter sits above the pane, Run bar and all, so up is taller. A step is a line of output, give or take.
  const KEY_STEPS: Record<string, number> = { ArrowUp: 22, ArrowDown: -22 };

  splitter.addEventListener("keydown", (event) => {
    const step = KEY_STEPS[event.key];
    if (!step) return;
    event.preventDefault();
    const now = bounds();
    resize(now.height + step, now);
  });

  // A focusable separator owes a screen reader its position. The window moves the bounds as surely as the splitter does, so the values follow both halves of the frame rather than the splitter's own events.
  const describe = new ResizeObserver(() => {
    const { height, min, max } = bounds();
    splitter.setAttribute("aria-valuemin", String(Math.round(min)));
    splitter.setAttribute("aria-valuemax", String(Math.round(max)));
    splitter.setAttribute("aria-valuenow", String(Math.round(height)));
  });
  describe.observe(editor);
  describe.observe(output);

  runButton.addEventListener("click", async () => {
    if (running) return;
    running = true;
    const ticket = ++current;
    runButton.disabled = true;
    runButton.textContent = "Running…";
    // The last run's module goes with the last run's output: its crumb is about to be cleared off the line, and nothing else holds the URL.
    dropModule();
    setOutput("");

    // The line is a breadcrumb: each step names itself as it starts, then settles into a measurement and hands the end of the line to the next one. There is no separate success message at the end because none is needed — a line that reached "ran" is a program that compiled and ran, and it says so in more detail than "accepted" would, so that last crumb simply goes green and stands as the verdict.
    const done: (Node | string)[] = [];
    let ran: Node | string = "";
    setTrail([]);

    // Named here rather than waited for: spawning the worker and fetching its script takes long enough on a cold page to leave the line blank, and the first "begin" from the worker overwrites this the moment it lands, so guessing wrong costs nothing.
    setStep(loaded ? STEPS.compile.doing : STEPS.load.doing, "working");

    try {
      const result = await compileAndReport(source.value, (event) => {
        // Whether the compiler arrived is the worker's state, not the line's, so it is kept even for a run that has been overtaken.
        if (event.phase === "end" && event.step === "load") loaded = true;
        if (ticket !== current) return;

        if (event.phase === "begin") {
          setStep(STEPS[event.step].doing, "working");
          return;
        }
        // The run step is handed the size of the module it ran alongside its duration: with no second pane to state it, the breadcrumb is the only place the compiler's output gets measured — or offered.
        const crumb = STEPS[event.step].done(event.ms, event.bytes);

        // The run is the last step there is, so its crumb stays where the outcome goes rather than falling back into the trail: green, unshrinkable, and holding the slot an error would otherwise have taken.
        if (event.step === "run") {
          ran = crumb;
          setStep(crumb, "ok");
          return;
        }

        done.push(crumb);
        setTrail(done);
        setStep("");
      });

      // A compiler that never arrived has judged nothing, so the line says as much rather than laying the failure at the program's door.
      if (!result.ok && result.phase === "load") loaded = false;
      if (ticket !== current) return;

      if (!result.ok) {
        setOutput(result.error, "error");

        // The step that failed leaves no crumb, because its past tense would claim the one thing that did not happen: "compiled source in 42.1ms · refused source" is a line arguing with itself. The verdict carries the duration instead, which is what that crumb was really for — how long the compiler spent before refusing is worth as much as how long it spends accepting, and the commonest failure there is, a typo on a page already warm, would otherwise put a bare word on an empty line. A compiler that never arrived is the exception: it measured nothing worth reading, and says so without a number — as does a failure of the playground's own, which has no step to time.
        const took = result.ms === undefined ? "" : ` in ${result.ms.toFixed(1)}ms`;
        setStep(
          result.phase === "load" ? "never arrived" : `${result.phase === "compile" ? "refused source" : "failed"}${took}`,
          "error",
        );
        return;
      }

      // The bytes only travel with the result, so the crumb's link is armed here rather than where it was drawn — a few milliseconds of an anchor that does not lead anywhere, on a line nobody has had time to reach for yet.
      if (moduleLink) {
        moduleUrl = URL.createObjectURL(new Blob([result.bytes], { type: "application/wasm" }));
        moduleLink.href = moduleUrl;
        moduleLink.download = "program.wasm";
      }

      // stderr joins stdout, and the way the process ended joins both: the pane holds the transcript of the run, not a feed of one stream.
      const printed = [`${result.run.stdout}${result.run.stderr}`.trimEnd()];
      const trapped = Boolean(result.run.trap);
      if (result.run.trap) printed.push(result.run.trap);
      else if (result.run.exitCode) printed.push(`Process exited with code ${result.run.exitCode}`);

      // A run that trapped is a failed run, and the whole transcript is coloured as one: whatever the program managed to print before it died is part of the failure rather than output standing on its own.
      setOutput(printed.filter(Boolean).join("\n"), trapped ? "error" : undefined);
      // A trap is the one outcome the crumbs cannot convey on their own. It is not a clean finish, so the run's crumb gives up the outcome slot and falls back into the trail — how long the program took to reach the trap is still worth reading — and the verdict takes its place.
      if (trapped) {
        done.push(ran);
        setTrail(done);
        setStep("trapped", "error");
      }
    } finally {
      running = false;
      runButton.disabled = false;
      runButton.textContent = "Run";
    }
  });

  pick(EXAMPLES[0].name);
</script>
