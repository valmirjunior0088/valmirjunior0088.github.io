---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
---

<Base title="Playground — curios">
  <div class="page">
    <Nav crumb="playground" />

    <div class="main">
      <div class="intro">
        <h1>Playground</h1>
        <p>Pick an example or write your own curios — it typechecks and compiles to WebAssembly right here, nothing leaves your browser.</p>
      </div>

      <div class="tabs">
        <button class="tab" data-example="hello">hello world</button>
        <button class="tab" data-example="vec">vec append</button>
        <button class="tab" data-example="sym">sym proof</button>
        <button class="tab" data-example="error">type error</button>
      </div>

      <div class="code-card">
        <div class="code-card-topbar" style="justify-content:space-between;">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="display:flex; gap:8px;">
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
            </div>
            <span class="chip" id="filename">hello.crs</span>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <span class="status" id="status"></span>
            <button id="reset" class="btn btn-outline" style="font-size:13px; padding:8px 14px;">Reset</button>
            <button id="run" class="btn btn-primary" style="font-size:13px; padding:8px 18px;">Run &#9654;</button>
          </div>
        </div>

        <div class="editor">
          <div id="gutter" class="gutter"></div>
          <textarea id="editor" spellcheck="false"></textarea>
        </div>

        <div id="output" class="output" hidden></div>
      </div>
    </div>
  </div>
</Base>

<script type="module" is:inline>
  import { compileAndReport } from "/curios/loader.js";

  const EXAMPLES = {
    hello: {
      label: "hello.crs",
      code: 'use /std/{Io};\n\nIo/print("Hello, world!\\n")',
    },
    vec: {
      label: "vec.crs",
      code:
        "use /std/{Io, Nat};\n\n" +
        "pub induct Vec(T : Type) : (n : Nat) -> Type\n" +
        "| nil() : (0)\n" +
        "| cons(@m : Nat, x : T, xs : Vec(T, m)) : (m + 1)\n" +
        "end\n\n" +
        "pub rec append(@T : Type, @n : Nat, @m : Nat, v : Vec(T, n), w : Vec(T, m)) -> Vec(T, n + m) =\n" +
        "    match v : (v : Vec(T, k)) => Vec(T, k + m)\n" +
        "    | nil()          => w\n" +
        "    | cons(j, x, xs) => Vec/cons(x, append(xs, w))\n" +
        "    end;\n\n" +
        'Io/print("typechecks: Vec/append\\n")',
    },
    sym: {
      label: "sym.crs",
      code:
        "use /std/{Io, Eq};\n\n" +
        "pub let sym(@A : Type, @x : A, @y : A, p : Eq(x, y)) -> Eq(y, x) =\n" +
        "    match p : (q : Eq(A, s, t)) => Eq(t, s)\n" +
        "    | refl(z) => Eq/refl()\n" +
        "    end;\n\n" +
        'Io/print("typechecks: sym\\n")',
    },
    error: {
      label: "broken.crs",
      code:
        "use /std/{Io, Nat, Vec};\n\n" +
        "pub let broken(@n : Nat) -> Vec(Nat, n) =\n" +
        "    Vec/cons(0, Vec/nil());\n\n" +
        'Io/print("unreachable\\n")',
    },
  };

  const el = {
    tabs: document.querySelectorAll(".tab"),
    filename: document.getElementById("filename"),
    status: document.getElementById("status"),
    reset: document.getElementById("reset"),
    run: document.getElementById("run"),
    gutter: document.getElementById("gutter"),
    editor: document.getElementById("editor"),
    output: document.getElementById("output"),
  };

  let active = "hello";
  let running = false;
  let downloadUrl = null;

  function setActiveTab(key) {
    active = key;
    el.editor.value = EXAMPLES[key].code;
    el.filename.textContent = EXAMPLES[key].label;
    el.status.textContent = "";
    el.output.hidden = true;
    el.tabs.forEach((btn) => btn.classList.toggle("tab-active", btn.dataset.example === key));
    renderGutter();
  }

  function renderGutter() {
    const lines = el.editor.value.split("\n").length;
    el.gutter.innerHTML = "";
    for (let i = 1; i <= lines; i++) {
      const row = document.createElement("div");
      row.textContent = String(i);
      el.gutter.appendChild(row);
    }
  }

  el.editor.addEventListener("input", renderGutter);
  el.editor.addEventListener("scroll", () => {
    el.gutter.scrollTop = el.editor.scrollTop;
  });

  el.tabs.forEach((btn) => {
    btn.addEventListener("click", () => setActiveTab(btn.dataset.example));
  });

  el.reset.addEventListener("click", () => setActiveTab(active));

  el.run.addEventListener("click", async () => {
    if (running) return;
    running = true;
    el.run.disabled = true;
    el.run.textContent = "Running…";
    el.status.textContent = "compiling…";
    if (downloadUrl) {
      URL.revokeObjectURL(downloadUrl);
      downloadUrl = null;
    }

    const result = await compileAndReport(el.editor.value);

    el.output.hidden = false;
    if (result.ok) {
      el.output.className = "output ok-output";
      downloadUrl = URL.createObjectURL(new Blob([result.bytes], { type: "application/wasm" }));
      el.output.innerHTML = "";
      const line1 = document.createElement("div");
      line1.textContent = `✓ typechecked in ${result.typeMs.toFixed(1)}ms · compiled to wasm in ${result.wasmMs.toFixed(1)}ms (${result.bytes.length} bytes)`;
      el.output.appendChild(line1);

      const { run } = result;
      if (run.stdout || run.stderr || run.trap) {
        const programOutput = document.createElement("pre");
        programOutput.className = "program-output";
        programOutput.textContent = run.stdout + run.stderr;
        el.output.appendChild(programOutput);
      }
      if (run.trap) {
        const trapLine = document.createElement("div");
        trapLine.className = "trap-line";
        trapLine.textContent = `✗ ${run.trap}`;
        el.output.appendChild(trapLine);
      } else if (run.exitCode) {
        const exitLine = document.createElement("div");
        exitLine.textContent = `process exited with code ${run.exitCode}`;
        el.output.appendChild(exitLine);
      }

      const link = document.createElement("a");
      link.href = downloadUrl;
      link.download = el.filename.textContent.replace(/\.crs$/, ".wasm");
      link.textContent = "Download .wasm →";
      link.className = "download-link";
      el.output.appendChild(link);
      el.status.textContent = run.trap ? "✓ compiled · ✗ run failed" : "✓ compiled & ran";
    } else {
      el.output.className = "output err-output";
      el.output.textContent = result.error;
      el.status.textContent = result.phase === "typecheck" ? "✗ type error" : "✗ compile error";
    }

    running = false;
    el.run.disabled = false;
    el.run.textContent = "Run again ▶";
  });

  setActiveTab("hello");
</script>

<style>
  .main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px clamp(20px, 4vw, 64px) 110px;
  }
  .intro {
    margin-bottom: 28px;
  }
  .intro h1 {
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 600;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }
  .intro p {
    font-size: 15.5px;
    color: var(--fg-dimmer);
    margin: 0;
    max-width: 560px;
  }

  .tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .tab {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-dimmer);
  }
  .tab-active {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--fg);
  }

  .status {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-faint);
  }

  .editor {
    display: flex;
    height: 340px;
  }
  .gutter {
    width: 48px;
    flex-shrink: 0;
    overflow: hidden;
    padding: 20px 0;
    text-align: right;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--fg-fainter);
    user-select: none;
    border-right: 1px solid var(--border-soft);
  }
  .gutter div {
    padding-right: 14px;
  }
  textarea#editor {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    color: oklch(94% 0.006 285);
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.7;
    padding: 20px 24px;
    overflow: auto;
  }

  .output {
    border-top: 1px solid var(--border-soft);
    background: var(--bg-output);
    padding: 20px 28px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.75;
    white-space: pre-wrap;
  }
  .ok-output {
    color: var(--fg-faint);
  }
  .err-output {
    color: var(--red);
  }
  .download-link {
    display: block;
    margin-top: 10px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .program-output {
    margin: 12px 0;
    padding: 12px 14px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    color: var(--fg);
    white-space: pre-wrap;
    font: inherit;
  }
  .trap-line {
    color: var(--red);
    margin-bottom: 6px;
  }
</style>
