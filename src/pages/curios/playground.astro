---
import AppShell from "../../layouts/AppShell.astro";
import Toolbar from "../../components/Toolbar.astro";
import Editor from "../../components/Editor.astro";
import OutputPane from "../../components/OutputPane.astro";
import CheatsheetRail from "../../components/CheatsheetRail.astro";
import { EXAMPLES } from "../../data/examples";

const keys = Object.keys(EXAMPLES);
const defaultKey = keys[0];

const DIAGNOSTICS_PLACEHOLDER = 'No complaints yet. Hit "Run" and the compiler will find some.';
const STDOUT_PLACEHOLDER = "Nothing has been printed. Go break something — it just might show up here.";
---

<AppShell title="Playground · Curios">
  <div class="frame">
    <Toolbar scroll>
      <span class="label">EXAMPLES</span>
      {
        keys.map((key) => (
          <button class:list={["chip", key === defaultKey && "chip--on"]} data-example={key}>
            {EXAMPLES[key].label}
          </button>
        ))
      }
    </Toolbar>

    <Editor />

    <Toolbar>
      <button class="btn btn--primary btn--sm" data-run>Run ▸</button>
      <span class="status" data-status data-tone="idle">ready</span>
      <button class="btn btn--chip push" data-rail-toggle>‹ CHEATSHEET</button>
    </Toolbar>

    <div class="outputs">
      <OutputPane name="diagnostics" label="DIAGNOSTICS" placeholder={DIAGNOSTICS_PLACEHOLDER} count />
      <OutputPane name="stdout" label="STDOUT" placeholder={STDOUT_PLACEHOLDER} />
    </div>
  </div>

  <CheatsheetRail />
</AppShell>

<style>
  /* The frame fills whatever the header leaves and hands its slack to the editor. Nothing here scrolls; the editor and the two panes scroll inside themselves, which is what keeps the toolbars where you left them. */
  .frame {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .outputs {
    flex: 0 1 260px;
    min-height: 120px;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .status {
    font-family: var(--mono);
    font-size: var(--ms-chip);
  }

  .status[data-tone="idle"] {
    color: var(--fg-faint);
  }

  .status[data-tone="working"] {
    color: var(--accent);
  }

  .status[data-tone="error"] {
    color: var(--err);
  }
</style>

<script is:inline type="module" define:vars={{ EXAMPLES, defaultKey }}>
  // The compiler is a published asset rather than a source module, so this script stays inline and imports it at runtime. If the bundle was never fetched, the loader reports a load-phase failure and the diagnostics pane says so — the page still works, it just cannot compile.
  import { compileAndReport } from "/curios/loader.js";

  const source = document.querySelector("[data-source]");
  const gutter = document.querySelector("[data-gutter]");
  const runButton = document.querySelector("[data-run]");
  const status = document.querySelector("[data-status]");
  const chips = [...document.querySelectorAll("[data-example]")];
  const count = document.querySelector('[data-pane="diagnostics"] [data-count]');

  const panes = {
    diagnostics: document.querySelector('[data-pane="diagnostics"] [data-body]'),
    stdout: document.querySelector('[data-pane="stdout"] [data-body]'),
  };

  let running = false;

  function renderGutter() {
    const lines = source.value.split("\n").length;
    gutter.textContent = Array.from({ length: lines }, (_, index) => index + 1).join("\n");
  }

  function setPane(name, text, tone) {
    const pane = panes[name];
    const empty = !text;
    pane.textContent = empty ? pane.dataset.placeholder : text;
    pane.classList.toggle("empty", empty);
    pane.classList.toggle("error", !empty && tone === "error");
  }

  function setStatus(text, tone) {
    status.textContent = text;
    status.dataset.tone = tone;
  }

  function setCount(text, tone) {
    count.textContent = text;
    count.dataset.tone = tone ?? "";
  }

  function clearOutput() {
    setPane("diagnostics", "");
    setPane("stdout", "");
    setStatus("ready", "idle");
    setCount("");
  }

  function pick(key) {
    source.value = EXAMPLES[key].code;
    renderGutter();
    chips.forEach((chip) => chip.classList.toggle("chip--on", chip.dataset.example === key));
    clearOutput();
  }

  // Editing detaches the buffer from whichever example it started as, so no chip stays lit: what is in the editor is no longer that file.
  source.addEventListener("input", () => {
    renderGutter();
    chips.forEach((chip) => chip.classList.remove("chip--on"));
  });

  source.addEventListener("scroll", () => {
    gutter.scrollTop = source.scrollTop;
  });

  chips.forEach((chip) => chip.addEventListener("click", () => pick(chip.dataset.example)));

  document.querySelectorAll("[data-clear]").forEach((button) => {
    button.addEventListener("click", () => {
      const name = button.dataset.clear;
      setPane(name, "");
      if (name === "diagnostics") {
        setCount("");
        setStatus("ready", "idle");
      }
    });
  });

  runButton.addEventListener("click", async () => {
    if (running) return;
    running = true;
    runButton.disabled = true;
    runButton.textContent = "Running…";
    setStatus("compiling…", "working");
    setPane("diagnostics", "");
    setPane("stdout", "");
    setCount("");

    // The timings are the success message. Saying "accepted" beside them would only be a worse way of saying what they already say, so they take that slot outright and the status line reads ready → compiling… → the numbers. They accumulate as phases arrive, and the load phase only ever fires once, on the run that downloads the compiler.
    const timings = [];
    const showTimings = () => setStatus(timings.join(" · "), "idle");

    try {
      const result = await compileAndReport(source.value, (event) => {
        if (event.phase === "load") {
          timings.push(`compiler ${event.loadMs.toFixed(0)}ms`, `warm ${event.warmMs.toFixed(0)}ms`);
        } else if (event.phase === "compile") {
          // Only the durations here. The output size belongs to the diagnostics pane, which states it in full, and printing it twice would make the two readouts look like they were measuring different things.
          timings.push(`compile ${event.wasmMs.toFixed(1)}ms`);
        }
        showTimings();
      });

      if (!result.ok) {
        setPane("diagnostics", result.error, "error");
        setStatus("rejected", "error");
        setCount("1 ERROR", "error");
        return;
      }

      timings.push(`run ${result.runMs.toFixed(1)}ms`);
      showTimings();

      // stderr joins stdout rather than the diagnostics pane: both are the program talking, and only the compiler's complaints belong on the left.
      setPane("stdout", `${result.run.stdout}${result.run.stderr}`.trimEnd());

      const notes = [`No diagnostics — compiled to ${result.bytes.length} bytes of WebAssembly`];
      const trapped = Boolean(result.run.trap);
      if (trapped) notes.push(result.run.trap);
      else if (result.run.exitCode) notes.push(`Process exited with code ${result.run.exitCode}`);

      setPane("diagnostics", notes.join("\n"), trapped ? "error" : "ok");
      setCount(trapped ? "1 ERROR" : "CLEAN", trapped ? "error" : "ok");
      // A trap is the one success-path outcome the timings cannot convey on their own, so it overrides them; otherwise showTimings() has already left the numbers standing.
      if (trapped) setStatus("rejected", "error");
    } finally {
      running = false;
      runButton.disabled = false;
      runButton.textContent = "Run ▸";
    }
  });

  pick(defaultKey);
</script>
