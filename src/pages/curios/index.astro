---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
---

<Base title="curios — a language for the curious">
  <div class="page">
    <Nav />

    <!-- HERO -->
    <div id="top" class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-copy">
        <div class="eyebrow">// a small language, fully dependent</div>
        <h1>A language for<br /><em>the curious.</em></h1>
        <p class="lede">
          curios is a small, dependently-typed language that compiles straight to WebAssembly.
          Types can depend on values, proofs live right alongside ordinary code, and the
          compiler is happy to double-check your math homework.
        </p>
        <div class="hero-actions">
          <a href="/curios/playground" class="btn btn-primary hero-cta">Open the Playground &rarr;</a>
          <a href="#docs" class="btn btn-outline">Read the Docs</a>
        </div>
      </div>

      <div class="hero-snippet">
        <div class="code-card">
          <div class="code-card-topbar">
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <span class="code-card-filename">sym.crs</span>
          </div>
          <div class="code-body">
            <div class="code-line"><span class="ln">1</span><span class="cm">// symmetry of equality</span></div>
            <div class="code-line"><span class="ln">2</span><span><span class="kw">pub let</span> sym(@A : <span class="ty">Type</span>, @x : A, @y : A, p : <span class="ty">Eq</span>(x, y)) -&gt; Eq(y, x) =</span></div>
            <div class="code-line"><span class="ln">3</span><span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="kw">match</span> p : (q : Eq(A, s, t)) =&gt; Eq(t, s)</span></div>
            <div class="code-line"><span class="ln">4</span><span>&nbsp;&nbsp;&nbsp;&nbsp;| refl(z) =&gt; Eq/refl()</span></div>
            <div class="code-line"><span class="ln">5</span><span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="kw">end</span>;</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- PLAYGROUND PREVIEW -->
    <div id="playground-preview" class="section">
      <div class="section-intro" style="max-width:640px;">
        <div class="eyebrow">// try it now</div>
        <h2>Write proofs. Compile to WebAssembly. Right in the browser.</h2>
        <p class="section-lede">
          This preview compiles curios straight to WebAssembly using the same pipeline as the
          CLI &mdash; no install, no server round-trip.
        </p>
      </div>

      <div class="code-card">
        <div class="code-card-topbar" style="justify-content:space-between;">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="display:flex; gap:8px;">
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
            </div>
            <span class="chip">hello.crs</span>
          </div>
          <button id="preview-run" class="btn btn-primary" style="font-size:13px; padding:8px 18px;">Run &#9654;</button>
        </div>
        <div class="code-body" style="padding:26px 28px; font-size:15px; line-height:1.9;">
          <div class="code-line"><span class="ln" style="width:16px;">1</span><span><span class="kw">use</span> /std/{"{"}Io{"}"};</span></div>
          <div class="code-line"><span class="ln" style="width:16px;">2</span><span>&nbsp;</span></div>
          <div class="code-line"><span class="ln" style="width:16px;">3</span><span>Io/print(<span class="str">"Hello, world!\n"</span>)</span></div>
        </div>
        <div id="preview-output" class="output" hidden></div>
      </div>

      <div style="margin-top:20px;">
        <a href="/curios/playground" class="link-cta">Open the full playground &rarr;</a>
      </div>
    </div>

    <!-- DOCS -->
    <div id="docs" class="section docs-grid">
      <div>
        <div class="eyebrow">// go deeper</div>
        <h2>Every stage of the pipeline, documented.</h2>
        <p class="section-lede" style="max-width:480px;">
          curios compiles through a series of typed intermediate representations &mdash;
          text &rarr; core &rarr; ersd &rarr; cont &rarr; wasm. The Rust docs for the compiler
          cover every pass, type, and internal API, generated straight from source.
        </p>
        <div class="chip-row">
          <span class="chip chip-outline">curios-pipeline</span>
          <span class="chip chip-outline">curios-core</span>
          <span class="chip chip-outline">curios-text</span>
          <span class="chip chip-outline">curios-ersd</span>
          <span class="chip chip-outline">curios-cont</span>
          <span class="chip chip-outline">curios-wasm</span>
        </div>
      </div>
      <div class="docs-card">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
          <div class="docs-icon">{"{}"}</div>
          <div>
            <div class="docs-title">rustdoc reference</div>
            <div class="docs-subtitle">generated from source</div>
          </div>
        </div>
        <p class="section-lede" style="margin:0 0 24px;">
          Twelve crates, from the shared ABI foundations up through the CLI facade &mdash;
          browse types, traits, and functions the way the compiler team does.
        </p>
        <a href="https://github.com/valmirjunior0088/curios" target="_blank" rel="noopener" class="btn btn-primary">Browse the Rust docs &nearr;</a>
      </div>
    </div>

    <!-- FEATURES -->
    <div class="section">
      <div class="section-intro" style="max-width:640px;">
        <div class="eyebrow">// under the hood</div>
        <h2>Built for people who like their code checked twice.</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-glyph">&Pi; &Sigma;</div>
          <div class="feature-title">Dependent by design</div>
          <div class="feature-body">Function and tuple types are &Pi;/&Sigma; types &mdash; a type can mention a value that came before it, like a vector indexed by its own length.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">&equiv;</div>
          <div class="feature-title">Proofs, not comments</div>
          <div class="feature-body">A proof-irrelevant Prop sort, propositional equality, and the refl / sym / trans / cong toolkit, ready in the standard library.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">&mu;</div>
          <div class="feature-title">Indexed inductive types</div>
          <div class="feature-body">Declare your own data and proof families with index telescopes and per-constructor targets.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">@</div>
          <div class="feature-title">Erased at runtime</div>
          <div class="feature-body">Mark an argument @ and it vanishes after type-checking &mdash; zero-cost, with no trace left in the compiled WebAssembly.</div>
        </div>
      </div>
    </div>

    <!-- INSTALL -->
    <div class="section install-section">
      <div class="eyebrow" style="justify-content:center; display:flex;">// get started</div>
      <h2>Up and running in under a minute.</h2>
      <div class="install-card">
        <div><span class="fainter">$</span> cargo install curios</div>
        <div><span class="fainter">$</span> curios run hello.crs</div>
        <div class="ok">Hello, world!</div>
      </div>
      <p class="install-note">No Rust toolchain handy? Grab a prebuilt binary from the releases page, or just open the playground above.</p>
    </div>

    <!-- GITHUB -->
    <div class="github-band">
      <div class="github-inner">
        <div>
          <div class="github-title">Open source, early, and still finding its shape.</div>
          <div class="github-sub">github.com/valmirjunior0088/curios</div>
        </div>
        <a href="https://github.com/valmirjunior0088/curios" target="_blank" rel="noopener" class="btn btn-outline">View on GitHub &uarr;</a>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-brand">
        <div class="nav-mark">&lambda;</div>
        <div>
          <div class="footer-name">curios</div>
          <div class="footer-tag">a dependently-typed language, compiled to WebAssembly</div>
        </div>
      </div>
      <div class="footer-copy">&copy; 2026 curios &middot; early and experimental &mdash; no stability guarantee yet</div>
    </div>
  </div>
</Base>

<script type="module" is:inline src="/curios/loader.js"></script>
<script type="module" is:inline>
  import { compileAndReport } from "/curios/loader.js";

  const HELLO = 'use /std/{Io};\n\nIo/print("Hello, world!\\n")';

  const button = document.getElementById("preview-run");
  const output = document.getElementById("preview-output");

  button.addEventListener("click", async () => {
    button.disabled = true;
    button.textContent = "Running…";
    output.hidden = true;

    const result = await compileAndReport(HELLO);

    output.hidden = false;
    if (result.ok) {
      output.className = "output ok-output";
      const summary = `✓ typechecked in ${result.typeMs.toFixed(1)}ms · compiled to wasm in ${result.wasmMs.toFixed(1)}ms (${result.bytes.length} bytes)`;
      output.textContent = result.run.trap
        ? `${summary}\n✗ ${result.run.trap}`
        : `${summary}\n${result.run.stdout}${result.run.stderr}`.trimEnd();
    } else {
      output.className = "output err-output";
      output.textContent = result.error;
    }

    button.disabled = false;
    button.textContent = "Run again ▶";
  });
</script>

<style>
  .page {
    overflow-x: hidden;
    position: relative;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .hero {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 110px) clamp(20px, 4vw, 64px) clamp(50px, 7vw, 90px);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-glow {
    position: absolute;
    top: -80px;
    right: 60px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(110px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-copy,
  .hero-snippet {
    position: relative;
    z-index: 1;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(42px, 5.5vw, 70px);
    line-height: 1.04;
    font-weight: 600;
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }
  h1 em {
    font-weight: 500;
  }
  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg-dim);
    max-width: 520px;
    margin: 0 0 36px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-cta {
    font-size: 15px;
    padding: 14px 26px;
    box-shadow: var(--accent-glow);
  }
  .btn-outline {
    font-size: 15px;
    padding: 14px 26px;
  }

  .code-body {
    padding: 22px 24px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.85;
  }
  .code-line {
    display: flex;
    gap: 18px;
  }
  .ln {
    color: var(--fg-fainter);
    width: 14px;
    text-align: right;
    flex-shrink: 0;
  }
  .cm {
    color: var(--fg-faint);
  }
  .kw {
    color: oklch(74% 0.18 306);
  }
  .ty {
    color: oklch(82% 0.09 300);
  }
  .str {
    color: var(--green);
  }

  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px) 110px;
  }
  .section-intro {
    margin-bottom: 44px;
  }
  .section h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 600;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .section-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
    text-wrap: pretty;
  }

  .chip {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-dim);
    background: var(--bg-chip);
    padding: 4px 10px;
    border-radius: 6px;
  }
  .chip-outline {
    border: 1px solid var(--border);
    background: transparent;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .output {
    border-top: 1px solid var(--border-soft);
    background: var(--bg-output);
    padding: 20px 28px;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.8;
    white-space: pre-wrap;
  }
  .ok-output {
    color: var(--fg-faint);
  }
  .err-output {
    color: var(--red);
  }

  .link-cta {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .docs-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 34px;
    box-shadow: 0 20px 60px oklch(8% 0.01 285 / 45%);
  }
  .docs-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: oklch(24% 0.01 285);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 15px;
    color: var(--fg-dim);
  }
  .docs-title {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--fg);
    font-weight: 600;
  }
  .docs-subtitle {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-faint);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .feature-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 26px;
  }
  .feature-glyph {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .feature-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .feature-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-dimmer);
  }

  .install-section {
    max-width: 760px;
    text-align: center;
  }
  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    text-align: left;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 2;
  }
  .fainter {
    color: var(--fg-faint);
  }
  .ok {
    color: var(--green);
  }
  .install-note {
    font-size: 14.5px;
    color: var(--fg-faint);
    margin: 20px 0 0;
  }

  .github-band {
    background: var(--bg-card-alt);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  .github-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 28px;
  }
  .github-title {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .github-sub {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--fg-faint);
  }

  .footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-name {
    font-family: var(--serif);
    font-size: 17px;
    font-style: italic;
    font-weight: 600;
  }
  .footer-tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-faint);
  }
  .footer-copy {
    font-family: var(--mono);
    font-size: 12.5px;
    color: oklch(50% 0.01 285);
    text-align: right;
  }

  @media (max-width: 860px) {
    .hero,
    .docs-grid {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
