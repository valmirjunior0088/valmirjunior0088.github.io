---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import CodeCard from "../../components/CodeCard.astro";
import Editor from "../../components/Editor.astro";
import { PREVIEW_KEYS, HERO_SNIPPET } from "../../data/examples";
import { FEATURES, BENCHMARKS, STDLIB_MODULES, STDLIB_SNIPPET } from "../../data/home";
import { GITHUB_URL } from "../../data/site";

const renderInlineCode = (body: string) => body.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<Base title="curios — a language for the curious">
  <div class="page">
    <Nav />

    <div id="top" class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-copy">
        <div class="eyebrow">// a small language, fully dependent</div>
        <h1 class="h-serif">A language for<br /><em>the curious.</em></h1>
        <p class="lede">
          curios is a small, dependently-typed language that compiles straight to WebAssembly. Types can depend on values, proofs live right alongside ordinary code, and the compiler is happy to double-check your math homework.
        </p>
        <div class="hero-actions">
          <a href="/curios/playground" class="btn btn-primary hero-cta">Open the Playground &rarr;</a>
        </div>
      </div>

      <div class="hero-snippet">
        <CodeCard filename={HERO_SNIPPET.filename}>
          <div class="code-scroll">
            <div class="code-gutter">
              {HERO_SNIPPET.lines.map((_, i) => <div>{i + 1}</div>)}
            </div>
            <pre class="code-area" set:html={HERO_SNIPPET.lines.join("\n")} />
          </div>
        </CodeCard>
      </div>
    </div>

    <div id="playground-preview" class="section">
      <div class="section-intro">
        <div class="eyebrow">// the whole point</div>
        <h2 class="h-serif">This is Curios. Pick an example, hit run.</h2>
        <p class="section-lede">
          Nothing to install, nothing to read first &mdash; the playground typechecks and compiles straight to WebAssembly using the same pipeline as the CLI, entirely in your browser.
        </p>
      </div>

      <Editor editable={false} exampleKeys={PREVIEW_KEYS} preload />

      <div class="preview-cta">
        <a href="/curios/playground" class="link-cta">Open the full playground &rarr;</a>
      </div>
    </div>

    <div id="features" class="section">
      <div class="section-intro">
        <div class="eyebrow">// under the hood</div>
        <h2 class="h-serif">Built for people who like their code checked twice.</h2>
      </div>
      <div class="features-grid">
        {
          FEATURES.map((feature) => (
            <div class="feature-card">
              <div class="feature-glyph">{feature.glyph}</div>
              <div class="feature-title">{feature.title}</div>
              <div class="feature-body" set:html={renderInlineCode(feature.body)} />
            </div>
          ))
        }
      </div>
    </div>

    <div id="stdlib" class="section">
      <div class="section-intro">
        <div class="eyebrow">// the standard library</div>
        <h2 class="h-serif">Batteries included. Some of them certified.</h2>
        <p class="section-lede">
          An HTTPS request, a JSON decode, and a race between two mirrors, without leaving <code>/std</code> &mdash; and this being Curios, some batteries carry proofs. Strings store certified UTF-8, and <code>BigNat</code>'s arithmetic laws are machine-checked in the library itself, not in a paper about it.
        </p>
      </div>

      <div class="stdlib-grid">
        <div class="stdlib-snippet">
          <CodeCard filename={STDLIB_SNIPPET.filename}>
            <div class="code-scroll">
              <div class="code-gutter">
                {STDLIB_SNIPPET.lines.map((_, i) => <div>{i + 1}</div>)}
              </div>
              <pre class="code-area" set:html={STDLIB_SNIPPET.lines.join("\n")} />
            </div>
          </CodeCard>
        </div>

        <div class="stdlib-modules">
          {
            STDLIB_MODULES.map((module) => (
              <div class="stdlib-row">
                <div class="stdlib-name">{module.name}</div>
                <div class="stdlib-desc" set:html={renderInlineCode(module.body)} />
              </div>
            ))
          }
          <div class="stdlib-foot">
            plus files, processes, clocks, randomness, and TCP servers &mdash; the boring parts are in there too.
          </div>
        </div>
      </div>
    </div>

    <div id="benchmarks" class="section">
      <div class="section-intro">
        <div class="eyebrow">// how it performs</div>
        <h2 class="h-serif">Benchmarked against the languages it keeps company with.</h2>
        <p class="section-lede">
          A single-machine snapshot (wasmtime on Cranelift, one pinned core) &mdash; orientation, not a leaderboard. Curios only targets WebAssembly, so this is the fair fight: same engine, same workloads.
        </p>
      </div>

      <div class="bench-grid">
        {
          BENCHMARKS.map((bench) => (
            <CodeCard filename={bench.filename}>
              <div class="bench-table">
                {
                  bench.rows.map((row) => (
                    <div class:list={["bench-row", row.variant && `bench-${row.variant}`]}>
                      <span>{row.lang}</span>
                      <span>{row.value}</span>
                    </div>
                  ))
                }
              </div>
            </CodeCard>
          ))
        }
      </div>

      <div class="bench-note">
        <p>
          <span class="fg-full">Reading it straight:</span> Curios lands within 1.65&times; of Rust on the integer loop and within 2&times; on allocation &mdash; with checked <span class="fg-full">Nat</span>/<span class="fg-full">Int</span> arithmetic included, work Rust isn't doing. The two workloads are deliberate extremes &mdash; <span class="fg-full">lcg</span> never allocates, <span class="fg-full">trees</span> does nothing else &mdash; so those two multipliers bracket where a real program should land.
        </p>
      </div>
    </div>

    <div class="section install-section">
      <div class="eyebrow eyebrow-center">// get started</div>
      <h2 class="h-serif">Up and running in under a minute.</h2>
      <div class="install-card">
        <div class="fainter">// grab the curios binary for your platform</div>
        <div><span class="fainter">$</span> chmod +x curios &amp;&amp; ./curios run hello.crs</div>
        <div class="ok">Hello, world!</div>
        <div class="fainter">// or bundle a standalone executable &mdash; AOT-compiled, launches without a JIT</div>
        <div><span class="fainter">$</span> ./curios compile hello.crs -o hello &amp;&amp; ./hello</div>
        <div class="ok">Hello, world!</div>
      </div>
      <p class="install-note">Prebuilt binaries for Linux (x86_64/aarch64) and macOS (aarch64) live on the <a href={`${GITHUB_URL}/releases`} target="_blank" rel="noopener">releases page</a>. Prefer building from source? <code>git clone</code> the repo and follow the README. Or just open the playground above &mdash; nothing to install.</p>
    </div>

    <div class="github-band">
      <div class="github-inner">
        <div>
          <div class="github-title">Open source, early, and still finding its shape.</div>
          <div class="github-sub">github.com/valmirjunior0088/curios</div>
        </div>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn btn-outline"
          >View on GitHub &uarr;<span class="visually-hidden"> (opens in new tab)</span></a
        >
      </div>
    </div>

    <div class="footer">
      <div class="footer-brand">
        <div class="nav-mark">&lambda;</div>
        <div>
          <div class="footer-name">curios</div>
          <div class="footer-tag">a dependently-typed language, compiled to WebAssembly</div>
        </div>
      </div>
      <div class="footer-copy">&copy; 2026 curios &middot; early and experimental &mdash; no stability guarantee yet</div>
    </div>
  </div>
</Base>

<style>
  .page {
    overflow-x: hidden;
    position: relative;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .hero {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 110px) clamp(20px, 4vw, 64px) clamp(50px, 7vw, 90px);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-glow {
    position: absolute;
    top: -80px;
    right: 60px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(110px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-copy,
  .hero-snippet {
    position: relative;
    z-index: 1;
  }
  h1 {
    font-size: clamp(42px, 5.5vw, 70px);
    line-height: 1.04;
    margin: 0 0 24px;
  }
  h1 em {
    font-weight: 500;
  }
  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg-dim);
    max-width: 520px;
    margin: 0 0 36px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-cta {
    font-size: 15px;
    padding: 14px 26px;
    box-shadow: var(--accent-glow);
  }
  .btn-outline {
    font-size: 15px;
    padding: 14px 26px;
  }

  .cm {
    color: var(--fg-faint);
  }
  .kw {
    color: oklch(74% 0.18 306);
  }
  .ty {
    color: oklch(82% 0.09 300);
  }
  .str {
    color: var(--green);
  }

  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px) 110px;
  }
  .section-intro {
    margin-bottom: 44px;
  }
  .section h2 {
    font-size: clamp(30px, 3.4vw, 42px);
    margin: 0 0 16px;
  }
  .section-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--fg-dim);
    max-width: 640px;
    margin: 0;
    text-wrap: pretty;
  }

  .preview-cta {
    margin-top: 20px;
  }
  .link-cta {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .bench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .bench-table {
    padding: 8px 26px 22px;
    font-family: var(--mono);
    font-size: 14px;
  }
  .bench-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-soft);
    color: var(--fg-dim);
  }
  .bench-head {
    color: var(--fg-faint);
    font-size: 12px;
  }
  .bench-highlight {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    margin: 0 -14px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 8px;
  }
  .bench-faint {
    color: var(--fg-faint);
    border-bottom: none;
  }
  .bench-note {
    margin-top: 24px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 28px;
  }
  .bench-note p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
  }
  .fg-full {
    color: var(--fg);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .feature-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 26px;
  }
  .feature-glyph {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .feature-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .feature-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-dimmer);
  }
  .feature-body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .section-lede code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .stdlib-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
  }
  .stdlib-snippet {
    display: flex;
    flex-direction: column;
  }
  .stdlib-snippet > :global(.code-card) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .stdlib-snippet :global(.code-scroll) {
    flex: 1;
  }
  .stdlib-snippet .code-area,
  .stdlib-snippet .code-gutter {
    font-size: 13.5px;
    line-height: 1.75;
  }
  .stdlib-snippet :global(.kw) {
    color: oklch(74% 0.18 306);
  }
  .stdlib-snippet :global(.ty) {
    color: oklch(82% 0.09 300);
  }
  .stdlib-snippet :global(.cm) {
    color: var(--fg-faint);
  }
  .stdlib-snippet :global(.str) {
    color: var(--green);
  }
  .stdlib-modules {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 10px 26px 20px;
  }
  .stdlib-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .stdlib-name {
    flex-shrink: 0;
    width: 108px;
    font-family: var(--mono);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
  }
  .stdlib-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg-dim);
  }
  .stdlib-desc :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--fg);
  }
  .stdlib-foot {
    padding-top: 16px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg-faint);
    font-style: italic;
  }

  .install-section {
    max-width: 760px;
    text-align: center;
  }
  .eyebrow-center {
    display: flex;
    justify-content: center;
  }
  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    text-align: left;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 2;
  }
  .fainter {
    color: var(--fg-faint);
  }
  .ok {
    color: var(--green);
  }
  .install-note {
    font-size: 14.5px;
    color: var(--fg-faint);
    margin: 20px 0 0;
  }

  .github-band {
    background: var(--bg-card-alt);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  .github-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 28px;
  }
  .github-title {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .github-sub {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--fg-faint);
  }

  .footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-name {
    font-family: var(--serif);
    font-size: 17px;
    font-style: italic;
    font-weight: 600;
  }
  .footer-tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-faint);
  }
  .footer-copy {
    font-family: var(--mono);
    font-size: 12.5px;
    color: oklch(50% 0.01 285);
    text-align: right;
  }

  @media (max-width: 860px) {
    .hero,
    .bench-grid,
    .stdlib-grid {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
