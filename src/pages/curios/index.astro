---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import CodeCard from "../../components/CodeCard.astro";
import Editor from "../../components/Editor.astro";
import { PREVIEW_KEYS, HERO_SNIPPET } from "../../data/examples";
import { FEATURES, BENCHMARKS, STDLIB_MODULES, STDLIB_SNIPPET } from "../../data/home";
import { GITHUB_URL } from "../../data/site";

const renderInlineCode = (body: string) => body.replace(/`([^`]+)`/g, "<code>$1</code>");
const INSTALL_URL = `${GITHUB_URL}/releases/latest/download/install.sh`;
const INSTALL_COMMAND = `curl -fsSL ${INSTALL_URL} | sh`;
const USAGE_URL = `${GITHUB_URL}/blob/main/documentation/USAGE.md`;

// These two snippets sit in narrow grid columns, and a code card clips rather
// than wraps — outgrow the column and it scrolls sideways instead of failing,
// which is exactly the kind of regression nobody notices. So these two are kept
// out of `curios format` on width grounds: canonical style unwraps telescopes
// onto ~90 char lines, which the hero cannot hold at any viewport. Wrap them by
// hand, and only where the width actually demands it: a line the formatter would
// leave alone is left alone, so these snippets take no position on shapes the
// formatter owns. (Four playground examples are also exempt, but for readability
// rather than width; see playground.astro.) Budgets are the
// 1280px case, less the 46px
// gutter and 44px of code padding: .hero splits 1fr/1fr with a 56px gap,
// .stdlib-grid 1.1fr/0.9fr with 24px. Both narrow further between the 860px
// breakpoint and ~1130px, where they scroll — accepted, and the reason to
// spend the headroom these budgets leave rather than sit right on them.
const ENTITIES: Record<string, string> = { "&gt;": ">", "&lt;": "<", "&amp;": "&", "&hellip;": "…", "&rarr;": "→" };
const plainWidth = (line: string) =>
  line.replace(/<[^>]+>/g, "").replace(/&\w+;/g, (m) => ENTITIES[m] ?? m).length;

for (const [name, snippet, budget] of [
  ["hero", HERO_SNIPPET, 52],
  ["stdlib", STDLIB_SNIPPET, 65],
] as const) {
  for (const line of snippet.lines) {
    const width = plainWidth(line);
    if (width > budget)
      console.warn(`[${name}] ${snippet.filename} line is ${width} chars (budget ${budget}), will scroll: ${line.replace(/<[^>]+>/g, "").trim().slice(0, 40)}`);
  }
}
---

<Base title="Curios — a language for the curious">
  <div class="page">
    <Nav />

    <div id="top" class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-copy">
        <div class="eyebrow">// a small language, fully dependent</div>
        <h1 class="h-serif">A language for<br /><em>the curious.</em></h1>
        <p class="lede">
          Curios is a small, dependently-typed language that compiles straight to WebAssembly. Types can depend on values, proofs live right alongside ordinary code, and the compiler is happy to double-check your math homework.
        </p>
        <div class="hero-actions">
          <a href="/curios/playground" class="btn btn-primary hero-cta">Open the Playground &rarr;</a>
        </div>
      </div>

      <div class="hero-snippet at-start">
        <CodeCard filename={HERO_SNIPPET.filename}>
          <div class="hero-scroll">
            <div class="code-scroll">
              <div class="code-gutter">
                {HERO_SNIPPET.lines.map((_, i) => <div>{i + 1}</div>)}
              </div>
              <pre class="code-area" set:html={HERO_SNIPPET.lines.join("\n")} />
            </div>
            <div class="hero-fade hero-fade-top" aria-hidden="true"></div>
            <div class="hero-fade hero-fade-bottom" aria-hidden="true"></div>
          </div>
        </CodeCard>
      </div>
    </div>

    <div id="playground-preview" class="section">
      <div class="section-intro">
        <div class="eyebrow">// the whole point</div>
        <h2 class="h-serif">This is Curios. Pick an example, hit run.</h2>
        <p class="section-lede">
          Nothing to install, nothing to read first &mdash; the playground typechecks and compiles straight to WebAssembly using the same pipeline as the CLI, entirely in your browser.
        </p>
      </div>

      <Editor editable={false} exampleKeys={PREVIEW_KEYS} preload />

      <div class="preview-cta">
        <a href="/curios/playground" class="link-cta">Open the full playground &rarr;</a>
      </div>
    </div>

    <div id="features" class="section">
      <div class="section-intro">
        <div class="eyebrow">// under the hood</div>
        <h2 class="h-serif">Built for people who like their code checked twice.</h2>
        <p class="section-lede">
          Under it all is a small dependent type theory &mdash; &Pi; and &Sigma;, equality proofs, indexed families &mdash; wrapped in the ergonomics of a modern functional language. The compiler does its double-checking up front, then erases the evidence: what ships is plain WebAssembly.
        </p>
      </div>
      <div class="features-grid">
        {
          FEATURES.map((feature) => (
            <div class="feature-card">
              <div class="feature-head">
                <div class="feature-glyph"><span class="feature-glyph-mark">{feature.glyph}</span></div>
                <div class="feature-title">{feature.title}</div>
              </div>
              <div class="feature-body" set:html={renderInlineCode(feature.body)} />
            </div>
          ))
        }
      </div>
    </div>

    <div id="stdlib" class="section">
      <div class="section-intro">
        <div class="eyebrow">// the standard library</div>
        <h2 class="h-serif">Batteries included. Some of them certified.</h2>
        <p class="section-lede">
          An HTTPS request, a JSON decode, and a race between two mirrors, without leaving <code>/std</code> &mdash; and this being Curios, some batteries carry proofs. Strings store certified UTF-8, and <code>BigNat</code>'s arithmetic laws are machine-checked in the library itself, not in a paper about it.
        </p>
      </div>

      <div class="stdlib-grid">
        <div class="stdlib-snippet">
          <CodeCard filename={STDLIB_SNIPPET.filename}>
            <div class="code-scroll">
              <div class="code-gutter">
                {STDLIB_SNIPPET.lines.map((_, i) => <div>{i + 1}</div>)}
              </div>
              <pre class="code-area" set:html={STDLIB_SNIPPET.lines.join("\n")} />
            </div>
          </CodeCard>
        </div>

        <div class="stdlib-modules">
          {
            STDLIB_MODULES.map((module) => (
              <div class="stdlib-row">
                <div class="stdlib-name">{module.name}</div>
                <div class="stdlib-desc" set:html={renderInlineCode(module.body)} />
              </div>
            ))
          }
          <div class="stdlib-foot">
            plus files, processes, clocks, randomness, and TCP servers &mdash; the boring parts are in there too.
          </div>
        </div>
      </div>
    </div>

    <div id="benchmarks" class="section">
      <div class="section-intro">
        <div class="eyebrow">// how it performs</div>
        <h2 class="h-serif">Benchmarked against the languages it keeps company with.</h2>
        <p class="section-lede">
          A single-machine snapshot (wasmtime on Cranelift, one pinned core) &mdash; orientation, not a leaderboard. Curios only targets WebAssembly, so this is the fair fight: same engine, same workloads.
        </p>
      </div>

      <div class="bench-grid">
        {
          BENCHMARKS.map((bench) => (
            <CodeCard filename={bench.filename}>
              <div class="bench-table">
                {
                  bench.rows.map((row) => (
                    <div class:list={["bench-row", row.variant && `bench-${row.variant}`]}>
                      <span>{row.lang}</span>
                      <span>{row.value}</span>
                    </div>
                  ))
                }
              </div>
            </CodeCard>
          ))
        }
      </div>

      <div class="bench-note">
        <p>
          <span class="fg-full">Reading it straight:</span> Curios lands within 1.7&times; of Rust on the integer loop and right at 2&times; on allocation &mdash; with checked <span class="fg-full">Nat</span>/<span class="fg-full">Int</span> arithmetic included, work Rust isn't doing. The two workloads are deliberate extremes &mdash; <span class="fg-full">lcg</span> never allocates, <span class="fg-full">trees</span> does nothing else &mdash; so those two multipliers bracket where a real program should land.
        </p>
      </div>
    </div>

    <div class="section install-section">
      <div class="eyebrow eyebrow-center">// get started</div>
      <h2 class="h-serif">Up and running in under a minute.</h2>
      <div class="install-card">
        <div class="fainter">// one line, no options &mdash; checksummed, into ~/.local/bin</div>
        <div class="install-row">
          <div class="install-cmd"><span class="fainter">$</span> curl -fsSL {INSTALL_URL} | sh</div>
          <button type="button" class="copy-btn" data-copy={INSTALL_COMMAND} aria-label="Copy the install command">copy</button>
        </div>
        <div><span class="fainter">$</span> curios run hello.crs</div>
        <div class="ok">Hello, world!</div>
      </div>
      <div class="install-card">
        <div class="fainter">// or bundle a standalone executable &mdash; AOT-compiled, no JIT</div>
        <div><span class="fainter">$</span> curios compile hello.crs -o hello &amp;&amp; ./hello</div>
        <div class="ok">Hello, world!</div>
      </div>
      <div class="install-card">
        <div class="fainter">// outgrown one file? lib.crs is the library, exe.crs the program</div>
        <div><span class="fainter">$</span> curios new hello &amp;&amp; cd hello &amp;&amp; curios run</div>
        <div class="ok">Hello, world!</div>
      </div>
      <p class="install-note">Prebuilt for Linux (x86_64/aarch64) and macOS (aarch64) &mdash; every binary and checksum is on the <a href={`${GITHUB_URL}/releases`} target="_blank" rel="noopener">releases page</a>.<br />Anywhere else, <code>git clone</code> the repo and build from source.<br />Dependencies, umbrellas, and the rest of the command line live in <a href={USAGE_URL} target="_blank" rel="noopener">the usage reference</a>.<br />Or just open the playground above &mdash; nothing to install.</p>
    </div>

    <div class="github-band">
      <div class="github-inner">
        <div>
          <div class="github-title">Open source, early, and still finding its shape.</div>
          <div class="github-sub">github.com/valmirjunior0088/curios</div>
        </div>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn btn-outline"
          >View on GitHub &uarr;<span class="visually-hidden"> (opens in new tab)</span></a
        >
      </div>
    </div>

    <div class="footer">
      <div class="footer-brand">
        <div class="nav-mark">&lambda;</div>
        <div>
          <div class="footer-name">Curios</div>
          <div class="footer-tag">a dependently-typed language, compiled to WebAssembly</div>
        </div>
      </div>
      <div class="footer-copy">&copy; 2026 Curios &middot; early and experimental &mdash; no stability guarantee yet</div>
    </div>
  </div>
</Base>

<style>
  .page {
    overflow-x: hidden;
    position: relative;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .hero {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 110px) clamp(20px, 4vw, 64px) clamp(50px, 7vw, 90px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-glow {
    position: absolute;
    top: -80px;
    right: 60px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(110px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-copy,
  .hero-snippet {
    position: relative;
    z-index: 1;
  }
  /* contain: size zeroes the snippet's intrinsic height, so the copy column
     alone sets the row — the card stretches to it and the code scrolls */
  .hero-snippet {
    align-self: stretch;
    contain: size;
    display: flex;
    flex-direction: column;
  }
  .hero-snippet > :global(.code-card) {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  /* positioning context for the fades — no padding, so they span the full
     width and pin to the scroll viewport (below the filename bar) */
  .hero-scroll {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .hero-snippet .code-scroll {
    flex: 1;
    min-height: 0;
    /* the one and only scroll container: the pre below overflows visibly
       into it, instead of nesting a second scroller */
    overflow: auto;
    align-items: flex-start;
  }
  /* purple hints that the code keeps going past the fold; each toggle hides
     its fade once the reader reaches that edge */
  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    height: 40px;
    pointer-events: none;
    opacity: 1;
    transition: opacity 150ms ease;
  }
  .hero-fade-top {
    top: 0;
    background: linear-gradient(
      to top,
      transparent,
      color-mix(in srgb, var(--accent) 50%, var(--bg-card)) 90%
    );
  }
  .hero-fade-bottom {
    bottom: 0;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--accent) 50%, var(--bg-card)) 90%
    );
  }
  .hero-snippet.at-start .hero-fade-top {
    opacity: 0;
  }
  .hero-snippet.at-end .hero-fade-bottom {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      transition: none;
    }
  }
  .hero-snippet .code-area {
    overflow: visible;
  }
  .hero-snippet .code-gutter {
    position: sticky;
    left: 0;
    background: var(--bg-card);
  }
  /* the pre-formatted code snippets would otherwise set the tracks' min
     width and push the single-column layouts past the viewport on phones */
  .hero > *,
  .stdlib-grid > *,
  .bench-grid > :global(*) {
    min-width: 0;
  }
  h1 {
    font-size: clamp(42px, 5.5vw, 70px);
    line-height: 1.04;
    margin: 0 0 24px;
  }
  h1 em {
    font-weight: 500;
  }
  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg-dim);
    margin: 0 0 36px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-cta {
    font-size: 15px;
    padding: 14px 26px;
    box-shadow: var(--accent-glow);
  }
  .btn-outline {
    font-size: 15px;
    padding: 14px 26px;
  }

  .cm {
    color: var(--fg-faint);
  }
  .kw {
    color: oklch(74% 0.18 306);
  }
  .ty {
    color: oklch(82% 0.09 300);
  }
  .str {
    color: var(--green);
  }

  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px) 110px;
  }
  .section-intro {
    margin-bottom: 44px;
  }
  .section h2 {
    font-size: clamp(30px, 3.4vw, 42px);
    margin: 0 0 16px;
  }
  .section-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
    text-wrap: pretty;
  }

  .preview-cta {
    margin-top: 20px;
  }
  .link-cta {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .bench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .bench-table {
    padding: 8px 26px 22px;
    font-family: var(--mono);
    font-size: 14px;
  }
  .bench-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-soft);
    color: var(--fg-dim);
  }
  .bench-head {
    color: var(--fg-faint);
    font-size: 12px;
  }
  .bench-highlight {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    margin: 0 -14px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 8px;
  }
  .bench-faint {
    color: var(--fg-faint);
    border-bottom: none;
  }
  .bench-note {
    margin-top: 24px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 28px;
  }
  .bench-note p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
  }
  .fg-full {
    color: var(--fg);
  }

  /* ten cards, an even 2 / 2 / 2 / 2 / 2 */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .feature-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 26px;
  }
  .feature-glyph {
    /* A fixed square token, like the inline code chips: every glyph shares the
       same box whatever its width. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-family: var(--mono);
    font-size: 17px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 9px;
    flex: none;
  }
  .feature-glyph-mark {
    /* Trim the line box to the cap/baseline band — the same trick as the
       cheatsheet title — so each glyph optically centres in the square. */
    line-height: 1;
    text-box: trim-both cap alphabetic;
  }
  .feature-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .feature-title {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-box: trim-both cap alphabetic;
  }
  .feature-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-dimmer);
  }
  .feature-body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .section-lede code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .stdlib-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
  }
  .stdlib-snippet {
    display: flex;
    flex-direction: column;
  }
  .stdlib-snippet > :global(.code-card) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .stdlib-snippet :global(.code-scroll) {
    flex: 1;
  }
  .stdlib-snippet .code-area,
  .stdlib-snippet .code-gutter {
    font-size: 13.5px;
    line-height: 1.75;
  }
  .stdlib-snippet :global(.kw) {
    color: oklch(74% 0.18 306);
  }
  .stdlib-snippet :global(.ty) {
    color: oklch(82% 0.09 300);
  }
  .stdlib-snippet :global(.cm) {
    color: var(--fg-faint);
  }
  .stdlib-snippet :global(.str) {
    color: var(--green);
  }
  .stdlib-modules {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 10px 26px 20px;
  }
  .stdlib-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .stdlib-name {
    flex-shrink: 0;
    width: 108px;
    font-family: var(--mono);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
  }
  .stdlib-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg-dim);
  }
  .stdlib-desc :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    color: var(--fg);
  }
  .stdlib-foot {
    padding-top: 16px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg-faint);
    font-style: italic;
  }

  .install-section {
    max-width: 880px;
    text-align: center;
  }
  .eyebrow-center {
    display: flex;
    justify-content: center;
  }
  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    text-align: left;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 2;
    overflow-x: auto;
  }
  .install-card > div {
    white-space: nowrap;
  }
  .install-card + .install-card {
    margin-top: 16px;
  }
  .install-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  /* The install URL is the one line no card width fits. Rather than wrap it
     or scroll the card, it runs under a fade and stops — the button beside it
     is what makes that honest, since the tail is to be copied, not read. The
     visible head still carries the host and most of the path, so nobody is
     asked to pipe an unreadable URL into a shell. */
  .install-cmd {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
  }
  .copy-btn {
    flex: none;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--fg-dim);
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 10px;
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .copy-btn:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .copy-btn.is-copied {
    color: var(--green);
    border-color: var(--green);
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-btn {
      transition: none;
    }
  }
  .fainter {
    color: var(--fg-faint);
  }
  .ok {
    color: var(--green);
  }
  .install-note {
    font-size: 14.5px;
    color: var(--fg-faint);
    margin: 20px 0 0;
  }

  .github-band {
