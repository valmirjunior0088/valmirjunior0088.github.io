---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
---

<Base title="curios — a language for the curious">
  <div class="page">
    <Nav />

    <!-- HERO -->
    <div id="top" class="hero">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-copy">
        <div class="eyebrow">// a small language, fully dependent</div>
        <h1>A language for<br /><em>the curious.</em></h1>
        <p class="lede">
          curios is a small, dependently-typed language that compiles straight to WebAssembly.
          Types can depend on values, proofs live right alongside ordinary code, and the
          compiler is happy to double-check your math homework.
        </p>
        <div class="hero-actions">
          <a href="/curios/playground" class="btn btn-primary hero-cta">Open the Playground &rarr;</a>
        </div>
      </div>

      <div class="hero-snippet">
        <div class="code-card">
          <div class="code-card-topbar">
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <span class="code-card-filename">vec.crs</span>
          </div>
          <div class="code-body">
            <div class="code-line"><span class="ln">1</span><span class="cm">// a vector indexed by its own length</span></div>
            <div class="code-line"><span class="ln">2</span><span><span class="kw">pub induct</span> <span class="ty">Vec</span>(T : <span class="ty">Type</span>) : (n : <span class="ty">Nat</span>) -&gt; Type</span></div>
            <div class="code-line"><span class="ln">3</span><span>| nil() : (0)</span></div>
            <div class="code-line"><span class="ln">4</span><span>| cons(@m : Nat, x : T, xs : Vec(T, m)) : (m + 1)</span></div>
            <div class="code-line"><span class="ln">5</span><span><span class="kw">end</span></span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- PLAYGROUND PREVIEW -->
    <div id="playground-preview" class="section">
      <div class="section-intro" style="max-width:640px;">
        <div class="eyebrow">// the whole point</div>
        <h2>This is curios. Pick an example, hit run.</h2>
        <p class="section-lede">
          Nothing to install, nothing to read first &mdash; the playground typechecks and
          compiles straight to WebAssembly using the same pipeline as the CLI, entirely in
          your browser.
        </p>
      </div>

      <div class="tabs">
        <button class="tab" data-example="hello">hello world</button>
        <button class="tab" data-example="vec">vec append</button>
        <button class="tab" data-example="sym">sym proof</button>
        <button class="tab" data-example="error">type error</button>
      </div>

      <div class="code-card">
        <div class="code-card-topbar" style="justify-content:space-between;">
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="display:flex; gap:8px;">
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
              <div class="code-card-dot"></div>
            </div>
            <span class="chip" id="preview-filename">hello.crs</span>
          </div>
          <button id="preview-run" class="btn btn-primary" style="font-size:13px; padding:8px 18px;">Run &#9654;</button>
        </div>
        <div class="preview-editor">
          <div id="preview-gutter" class="gutter"></div>
          <pre id="preview-code" class="preview-code"></pre>
        </div>
        <div id="preview-output" class="output" hidden></div>
      </div>

      <div style="margin-top:20px;">
        <a href="/curios/playground" class="link-cta">Open the full playground &rarr;</a>
      </div>
    </div>

    <!-- FEATURES -->
    <div class="section">
      <div class="section-intro" style="max-width:640px;">
        <div class="eyebrow">// under the hood</div>
        <h2>Built for people who like their code checked twice.</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-glyph">&Pi; &Sigma;</div>
          <div class="feature-title">Dependent by design</div>
          <div class="feature-body">Function and tuple types are &Pi;/&Sigma; types &mdash; a type can mention a value that came before it, like a vector indexed by its own length.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">&equiv;</div>
          <div class="feature-title">Proofs, not comments</div>
          <div class="feature-body">A proof-irrelevant Prop sort, propositional equality, and the refl / sym / trans / cong toolkit, ready in the standard library.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">&mu;</div>
          <div class="feature-title">Indexed inductive types</div>
          <div class="feature-body">Declare your own data and proof families with index telescopes and per-constructor targets.</div>
        </div>
        <div class="feature-card">
          <div class="feature-glyph">@</div>
          <div class="feature-title">Erased at runtime</div>
          <div class="feature-body">Mark an argument @ and it vanishes after type-checking &mdash; zero-cost, with no trace left in the compiled WebAssembly.</div>
        </div>
      </div>
    </div>

    <!-- BENCHMARKS -->
    <div id="benchmarks" class="section">
      <div class="section-intro" style="max-width:640px;">
        <div class="eyebrow">// how it performs</div>
        <h2>Benchmarked against the languages it keeps company with.</h2>
        <p class="section-lede">
          A single-machine snapshot (wasmtime on Cranelift, one pinned core) &mdash;
          orientation, not a leaderboard. Curios only targets WebAssembly, so this is the
          fair fight: same engine, same workloads.
        </p>
      </div>

      <div class="bench-grid">
        <div class="code-card">
          <div class="code-card-topbar">
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <span class="code-card-filename">lcg &mdash; integer loop, N=100,000,000</span>
          </div>
          <div class="bench-table">
            <div class="bench-row bench-head"><span>language</span><span>mean &middot; vs best</span></div>
            <div class="bench-row"><span>Rust &rarr; wasm</span><span>268.3 ms &middot; 1.00&times;</span></div>
            <div class="bench-row"><span>AssemblyScript</span><span>315.0 ms &middot; 1.17&times;</span></div>
            <div class="bench-row bench-highlight"><span>Curios</span><span>444.6 ms &middot; 1.66&times;</span></div>
            <div class="bench-row bench-faint"><span>Grain</span><span>29,684 ms &middot; 110.6&times;</span></div>
          </div>
        </div>

        <div class="code-card">
          <div class="code-card-topbar">
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <div class="code-card-dot"></div>
            <span class="code-card-filename">trees &mdash; allocation, D=21</span>
          </div>
          <div class="bench-table">
            <div class="bench-row bench-head"><span>language</span><span>mean &middot; vs best</span></div>
            <div class="bench-row"><span>Rust &rarr; wasm</span><span>123.8 ms &middot; 1.00&times;</span></div>
            <div class="bench-row"><span>AssemblyScript</span><span>226.4 ms &middot; 1.83&times;</span></div>
            <div class="bench-row bench-highlight"><span>Curios</span><span>322.2 ms &middot; 2.60&times;</span></div>
            <div class="bench-row bench-faint"><span>Grain</span><span>1,781.8 ms &middot; 14.4&times;</span></div>
          </div>
        </div>
      </div>

      <div class="bench-note">
        <p>
          <span class="fg-full">Reading it straight:</span> Curios lands within 1.7&times; of Rust
          on tight integer work and within 2.6&times; on allocation &mdash; with checked
          <span class="fg-full">Nat</span>/<span class="fg-full">Int</span> arithmetic
          included, work Rust isn't doing. That's close company for a young,
          dependently-typed language sharing a track with hand-tuned systems code, and the
          remaining distance looks like a tuning problem, not a ceiling.
        </p>
      </div>
    </div>

    <!-- INSTALL -->
    <div class="section install-section">
      <div class="eyebrow" style="justify-content:center; display:flex;">// get started</div>
      <h2>Up and running in under a minute.</h2>
      <div class="install-card">
        <div><span class="fainter">$</span> cargo install curios</div>
        <div><span class="fainter">$</span> curios run hello.crs</div>
        <div class="ok">Hello, world!</div>
      </div>
      <p class="install-note">No Rust toolchain handy? Grab a prebuilt binary from the releases page, or just open the playground above.</p>
    </div>

    <!-- GITHUB -->
    <div class="github-band">
      <div class="github-inner">
        <div>
          <div class="github-title">Open source, early, and still finding its shape.</div>
          <div class="github-sub">github.com/valmirjunior0088/curios</div>
        </div>
        <a href="https://github.com/valmirjunior0088/curios" target="_blank" rel="noopener" class="btn btn-outline">View on GitHub &uarr;</a>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-brand">
        <div class="nav-mark">&lambda;</div>
        <div>
          <div class="footer-name">curios</div>
          <div class="footer-tag">a dependently-typed language, compiled to WebAssembly</div>
        </div>
      </div>
      <div class="footer-copy">&copy; 2026 curios &middot; early and experimental &mdash; no stability guarantee yet</div>
    </div>
  </div>
</Base>

<script type="module" is:inline src="/curios/loader.js"></script>
<script type="module" is:inline>
  import { compileAndReport } from "/curios/loader.js";

  const EXAMPLES = {
    hello: {
      label: "hello.crs",
      code: 'use /std/{Io};\n\nIo/print("Hello, world!\\n")',
    },
    vec: {
      label: "vec.crs",
      code:
        "use /std/{Io, Nat};\n\n" +
        "pub induct Vec(T : Type) : (n : Nat) -> Type\n" +
        "| nil() : (0)\n" +
        "| cons(@m : Nat, x : T, xs : Vec(T, m)) : (m + 1)\n" +
        "end\n\n" +
        "pub rec append(@T : Type, @n : Nat, @m : Nat, v : Vec(T, n), w : Vec(T, m)) -> Vec(T, n + m) =\n" +
        "    match v : (v : Vec(T, k)) => Vec(T, k + m)\n" +
        "    | nil()          => w\n" +
        "    | cons(j, x, xs) => Vec/cons(x, append(xs, w))\n" +
        "    end;\n\n" +
        'Io/print("typechecks: Vec/append\\n")',
    },
    sym: {
      label: "sym.crs",
      code:
        "use /std/{Io, Eq};\n\n" +
        "pub let sym(@A : Type, @x : A, @y : A, p : Eq(x, y)) -> Eq(y, x) =\n" +
        "    match p : (q : Eq(A, s, t)) => Eq(t, s)\n" +
        "    | refl(z) => Eq/refl()\n" +
        "    end;\n\n" +
        'Io/print("typechecks: sym\\n")',
    },
    error: {
      label: "broken.crs",
      code:
        "use /std/{Io, Nat, Vec};\n\n" +
        "pub let broken(@n : Nat) -> Vec(Nat, n) =\n" +
        "    Vec/cons(0, Vec/nil());\n\n" +
        'Io/print("unreachable\\n")',
    },
  };

  const el = {
    tabs: document.querySelectorAll("#playground-preview .tab"),
    filename: document.getElementById("preview-filename"),
    gutter: document.getElementById("preview-gutter"),
    code: document.getElementById("preview-code"),
    run: document.getElementById("preview-run"),
    output: document.getElementById("preview-output"),
  };

  let active = "hello";
  let running = false;

  function renderGutter(lineCount) {
    el.gutter.innerHTML = "";
    for (let i = 1; i <= lineCount; i++) {
      const row = document.createElement("div");
      row.textContent = String(i);
      el.gutter.appendChild(row);
    }
  }

  function setActiveTab(key) {
    active = key;
    const ex = EXAMPLES[key];
    el.filename.textContent = ex.label;
    el.code.textContent = ex.code;
    el.output.hidden = true;
    el.tabs.forEach((btn) => btn.classList.toggle("tab-active", btn.dataset.example === key));
    renderGutter(ex.code.split("\n").length);
  }

  el.tabs.forEach((btn) => {
    btn.addEventListener("click", () => setActiveTab(btn.dataset.example));
  });

  el.run.addEventListener("click", async () => {
    if (running) return;
    running = true;
    el.run.disabled = true;
    el.run.textContent = "Running…";
    el.output.hidden = true;

    const result = await compileAndReport(EXAMPLES[active].code);

    el.output.hidden = false;
    if (result.ok) {
      el.output.className = "output ok-output";
      const summary = `✓ typechecked in ${result.typeMs.toFixed(1)}ms · compiled to wasm in ${result.wasmMs.toFixed(1)}ms (${result.bytes.length} bytes)`;
      el.output.textContent = result.run.trap
        ? `${summary}\n✗ ${result.run.trap}`
        : `${summary}\n${result.run.stdout}${result.run.stderr}`.trimEnd();
    } else {
      el.output.className = "output err-output";
      el.output.textContent = result.error;
    }

    running = false;
    el.run.disabled = false;
    el.run.textContent = "Run again ▶";
  });

  setActiveTab("hello");
</script>

<style>
  .page {
    overflow-x: hidden;
    position: relative;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .hero {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 110px) clamp(20px, 4vw, 64px) clamp(50px, 7vw, 90px);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-glow {
    position: absolute;
    top: -80px;
    right: 60px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(110px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-copy,
  .hero-snippet {
    position: relative;
    z-index: 1;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(42px, 5.5vw, 70px);
    line-height: 1.04;
    font-weight: 600;
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }
  h1 em {
    font-weight: 500;
  }
  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg-dim);
    max-width: 520px;
    margin: 0 0 36px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-cta {
    font-size: 15px;
    padding: 14px 26px;
    box-shadow: var(--accent-glow);
  }
  .btn-outline {
    font-size: 15px;
    padding: 14px 26px;
  }

  .code-body {
    padding: 22px 24px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.85;
  }
  .code-line {
    display: flex;
    gap: 18px;
  }
  .ln {
    color: var(--fg-fainter);
    width: 14px;
    text-align: right;
    flex-shrink: 0;
  }
  .cm {
    color: var(--fg-faint);
  }
  .kw {
    color: oklch(74% 0.18 306);
  }
  .ty {
    color: oklch(82% 0.09 300);
  }
  .str {
    color: var(--green);
  }

  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px) 110px;
  }
  .section-intro {
    margin-bottom: 44px;
  }
  .section h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 600;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .section-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
    text-wrap: pretty;
  }

  .chip {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-dim);
    background: var(--bg-chip);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .tab {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-dimmer);
  }
  .tab-active {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--fg);
  }

  .preview-editor {
    display: flex;
    padding: 22px 0;
  }
  .gutter {
    width: 38px;
    flex-shrink: 0;
    text-align: right;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.9;
    color: var(--fg-fainter);
    padding-right: 14px;
    border-right: 1px solid var(--border-soft);
    user-select: none;
  }
  .preview-code {
    flex: 1;
    margin: 0;
    padding: 0 24px;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.9;
    white-space: pre;
    color: var(--fg);
    overflow-x: auto;
  }

  .output {
    border-top: 1px solid var(--border-soft);
    background: var(--bg-output);
    padding: 20px 28px;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.8;
    white-space: pre-wrap;
  }
  .ok-output {
    color: var(--fg-faint);
  }
  .err-output {
    color: var(--red);
  }

  .link-cta {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .bench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .bench-table {
    padding: 8px 26px 22px;
    font-family: var(--mono);
    font-size: 14px;
  }
  .bench-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-soft);
    color: var(--fg-dim);
  }
  .bench-head {
    color: var(--fg-faint);
    font-size: 12px;
  }
  .bench-highlight {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    margin: 0 -14px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 8px;
  }
  .bench-faint {
    color: var(--fg-faint);
    border-bottom: none;
  }
  .bench-note {
    margin-top: 24px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 28px;
  }
  .bench-note p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg-dim);
    margin: 0;
  }
  .fg-full {
    color: var(--fg);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .feature-card {
    background: var(--bg-card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 26px;
  }
  .feature-glyph {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .feature-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .feature-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-dimmer);
  }

  .install-section {
    max-width: 760px;
    text-align: center;
  }
  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    text-align: left;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 2;
  }
  .fainter {
    color: var(--fg-faint);
  }
  .ok {
    color: var(--green);
  }
  .install-note {
    font-size: 14.5px;
    color: var(--fg-faint);
    margin: 20px 0 0;
  }

  .github-band {
    background: var(--bg-card-alt);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  .github-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 28px;
  }
  .github-title {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .github-sub {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--fg-faint);
  }

  .footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-name {
    font-family: var(--serif);
    font-size: 17px;
    font-style: italic;
    font-weight: 600;
  }
  .footer-tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-faint);
  }
  .footer-copy {
    font-family: var(--mono);
    font-size: 12.5px;
    color: oklch(50% 0.01 285);
    text-align: right;
  }

  @media (max-width: 860px) {
    .hero,
    .bench-grid {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
