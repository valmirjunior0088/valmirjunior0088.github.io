<script>
  import { scrollFades } from "../../scripts/scrollFades";

  // The hero card is copy-height, so its code usually overflows. Fades hint at
  // more code above/below; `content` is the <pre>, watched because it reflows
  // taller when the mono web font swaps in (changing overflow with no event).
  const snippet = document.querySelector<HTMLElement>(".hero-snippet");
  const scroll = snippet?.querySelector<HTMLElement>(".code-scroll");

  if (snippet && scroll) {
    scrollFades({
      scroller: scroll,
      target: snippet,
      content: scroll.querySelector<HTMLElement>(".code-area"),
    });
  }

  // The label is the only feedback, so it has to report the failure too:
  // clipboard writes reject outside a secure context, and a button that
  // says "copied" when nothing was copied is worse than no button.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    let restore: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      let copied = true;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        copied = false;
      }

      button.textContent = copied ? "copied" : "copy failed";
      button.classList.toggle("is-copied", copied);

      clearTimeout(restore);
      restore = setTimeout(() => {
        button.textContent = "copy";
        button.classList.remove("is-copied");
      }, 1600);
    });
  }
</script>
