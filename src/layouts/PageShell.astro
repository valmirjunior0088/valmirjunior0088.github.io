---
// The document archetype: the page scrolls, the header rides along on top of it, and content sits in width-capped sections.
import Document from "./Document.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { PAGES, type PageId } from "../data/site";

interface Props {
  page: PageId;
  description?: string;
}

const { page, description } = Astro.props;
---

<Document title={PAGES[page].title} description={description}>
  <Header current={page} />
  <main>
    <slot />
  </main>
  <Footer />
</Document>
