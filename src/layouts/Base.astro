---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "curios is a small, dependently-typed language that compiles straight to WebAssembly.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: #a855f7;
    --accent-glow: 0 10px 30px color-mix(in srgb, var(--accent) 35%, transparent);
    --accent-glow-sm: 0 4px 14px color-mix(in srgb, var(--accent) 40%, transparent);
    --accent-hover: color-mix(in srgb, var(--accent) 85%, white);

    --bg: oklch(15% 0.004 285);
    --bg-card: oklch(11% 0.004 285);
    --bg-card-alt: oklch(18% 0.006 285);
    --bg-output: oklch(9% 0.004 285);
    --bg-chip: oklch(21% 0.008 288);

    --fg: oklch(96% 0.006 285);
    --fg-dim: oklch(75% 0.01 285);
    --fg-dimmer: oklch(70% 0.01 285);
    --fg-faint: oklch(55% 0.01 285);
    --fg-fainter: oklch(45% 0.01 285);

    --border: oklch(30% 0.02 290 / 55%);
    --border-soft: oklch(28% 0.015 288 / 45%);
    --border-strong: oklch(35% 0.02 288 / 70%);

    --green: oklch(78% 0.14 155);
    --red: oklch(72% 0.17 25);

    --radius-card: 16px;
    --radius-btn: 10px;

    --mono: "JetBrains Mono", monospace;
    --serif: "Newsreader", serif;

    --code-fs: 14.5px;
    --code-lh: 1.8;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--serif);
    min-height: 100vh;
  }

  a {
    color: inherit;
  }

  button {
    font: inherit;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blinkCursor {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  /* shared serif heading recipe, used by both pages */
  .h-serif {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* shared interactive bits, used by both pages */
  .navlink {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--fg-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .navlink:hover {
    color: var(--fg);
  }

  .btn {
    font-family: var(--mono);
    font-weight: 600;
    border-radius: var(--radius-btn);
    text-decoration: none;
    cursor: pointer;
    border: none;
    white-space: nowrap;
    transition: background 0.15s, opacity 0.15s;
  }
  .btn-primary {
    background: var(--accent);
    color: oklch(15% 0.01 300);
  }
  .btn-primary:hover {
    background: var(--accent-hover);
  }
  .btn-primary:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--fg);
    font-weight: 500;
  }
  .btn-outline:hover {
    background: var(--bg-chip);
  }

  .code-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 20px 60px oklch(8% 0.01 285 / 55%);
  }
  .code-card-topbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-soft);
  }
  .code-card-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: oklch(40% 0.01 285);
  }
  .code-card-filename {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-faint);
    margin-left: 6px;
  }

  /* Shared code body: a bordered line-number gutter beside a scrolling code
     area, with identical metrics across the hero snippet and both editor
     variants. The gutter and area share --code-lh so the numbers always line up
     with their lines; neither wraps (long lines scroll), so a one-number-per-
     line gutter can never drift. */
  .code-scroll {
    display: flex;
    align-items: flex-start;
    font-family: var(--mono);
    font-size: var(--code-fs);
    line-height: var(--code-lh);
  }
  .code-gutter {
    flex-shrink: 0;
    box-sizing: border-box;
    width: 46px;
    padding: 20px 10px 20px 0;
    text-align: right;
    color: var(--fg-fainter);
    user-select: none;
    border-right: 1px solid var(--border-soft);
  }
  .code-area {
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 20px 22px;
    font-family: var(--mono);
    font-size: var(--code-fs);
    line-height: var(--code-lh);
    color: var(--fg);
    white-space: pre;
    overflow-x: auto;
  }

  .chip {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-dim);
    background: var(--bg-chip);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
