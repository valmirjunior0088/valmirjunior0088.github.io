---
// The application archetype, and the exact opposite of PageShell's box model: the frame is pinned to the viewport and never scrolls. Anything that overflows scrolls inside its own pane, which is what lets the toolbars stay put while the editor and the output pane move independently.
import Document from "./Document.astro";
import Header from "../components/Header.astro";
import { PAGES } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Document title={title} description={description} bodyClass="app">
  <Header current="playground" sticky />
  {/* The frame has no room for a heading and the crumb beside the wordmark goes at the first narrow screen, so the page's one h1 is here, for the outline only. Without it the document's headings start at the rail's h2, inside a panel that is closed and inert nearly all the time. */}
  <h1 class="sr-only">{PAGES.playground.label}</h1>
  <slot />
</Document>

<style is:global>
  body.app {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* On a phone the frame stops being an application and becomes a document again. A frame pinned to 100dvh fights the on-screen keyboard, which resizes only the visual viewport; a page that scrolls has nothing to fight with. The playground's own styles pick up from here and give the editor a fixed height instead of the slack. */
  @media (max-width: 720px) {
    body.app {
      height: auto;
      min-height: 100dvh;
      overflow: visible;
    }
  }
</style>
