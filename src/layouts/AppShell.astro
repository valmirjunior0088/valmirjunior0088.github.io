---
// The application archetype, and the exact opposite of PageShell's box model: the frame is pinned to the viewport and never scrolls. Anything that overflows scrolls inside its own pane, which is what lets the toolbars stay put while the editor and the output panes move independently.
import Document from "./Document.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Document title={title} description={description} bodyClass="app">
  <Header current="playground" sticky />
  <slot />
</Document>

<style is:global>
  body.app {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* On a phone the frame stops being an application and becomes a document again. A frame pinned to 100dvh fights the on-screen keyboard, which resizes only the visual viewport; a page that scrolls has nothing to fight with. The playground's own styles pick up from here and give the editor a fixed height instead of the slack. */
  @media (max-width: 720px) {
    body.app {
      height: auto;
      min-height: 100dvh;
      overflow: visible;
    }
  }
</style>
