---
// The bare document both shells wrap. Everything page-specific — chrome, scrolling behaviour, whether the body is a scrolling document or a fixed application frame — belongs to PageShell or AppShell, not here.
import "../index.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "The Curios programming language: a dependently typed functional language compiled to WebAssembly-GC",
  bodyClass,
} = Astro.props;

// Latin subsets of the three variable faces, self-hosted from public/curios/fonts so the page owes nothing to a third-party host. Google serves one file per family across the whole weight axis, so the four Geist weights the design asks for cost one request, not four. Faustina is loaded italic-only, on purpose: every display setting on this site is italic, and the upright face would only ever be a mistake waiting to be made.
//
// Left to a stylesheet, a face is found late: the browser reads the CSS, lays out some text that asks for the face, and only then sends for the file — and paints a fallback in the meantime, which is the flash of the wrong font. So each file is preloaded from the head, its fetch starting the moment the HTML arrives, and the faces are declared right here rather than in index.css, so the rules do not wait on that file either. Every page uses all three: the playground lays out the cheatsheet's italic heading even while the rail is closed.
//
// `block` rather than `swap`: with the fetch begun that early the font is nearly always in hand by first paint, and on the rare slow load a moment of no text is better than a page drawn in a face it is about to throw away. After about three seconds the browser shows the fallback anyway, so a font that never arrives costs the wait and nothing worse.
const FONTS = [
  { family: "Geist", style: "normal", weight: "100 900", file: "/curios/fonts/geist.woff2" },
  { family: "Geist Mono", style: "normal", weight: "100 900", file: "/curios/fonts/geist-mono.woff2" },
  { family: "Faustina", style: "italic", weight: "300 800", file: "/curios/fonts/faustina-italic.woff2" },
];

// `block` holds each face's text back until that face's own file arrives, and the three files land at slightly different times — so left to itself the page reveals in instalments: the heading, then the prose a beat later, then the code. A page that holds everything until all three are in hand appears once, complete. The script below marks the document pending and lifts the mark when every face has loaded, or after three seconds — the browser's own limit for `block`, past which it would be showing fallbacks anyway. The mark is the script's to set, so a browser running no script never hides anything.
//
// The mark goes on at once, but the asking waits for the first frame. `document.fonts.load` has the browser work out the page's styles, and asked from the head it can do that before the stylesheets have arrived — whenever a face settles first, as a blocked or missing one does at once. The stylesheets then land on elements already styled with the browser's defaults, and every transition on the page runs from those: the hero's buttons faded in from link blue. A frame is only drawn once the stylesheets are in, so asking from inside one cannot get ahead of them, and the three seconds count from the first frame, much as `block`'s own do.
const PENDING = "fonts-pending";

const faces = [
  ...FONTS.map(
    ({ family, style, weight, file }) =>
      `@font-face { font-family: "${family}"; font-style: ${style}; font-weight: ${weight}; font-display: block; src: url("${file}") format("woff2"); }`,
  ),
  `html.${PENDING} body { visibility: hidden; }`,
].join("\n");

// The shorthand `document.fonts.load` asks for, one per face. Any weight inside a variable face's range resolves to the same file, so the bottom of each range will do.
const specs = FONTS.map(({ family, style, weight }) => `${style} ${weight.split(" ")[0]} 1em "${family}"`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/curios/brand/curios-mark.svg" type="image/svg+xml" />
    {/* A font is always fetched in CORS mode, and a preload only counts if it asks the same way — without `crossorigin` the browser would fetch every file twice. */}
    {FONTS.map(({ file }) => <link rel="preload" href={file} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={faces} />
    <script is:inline define:vars={{ PENDING, specs }}>
      const root = document.documentElement;
      root.classList.add(PENDING);
      requestAnimationFrame(() => {
        const loaded = Promise.allSettled(specs.map((spec) => document.fonts.load(spec)));
        const capped = new Promise((resolve) => setTimeout(resolve, 3000));
        Promise.race([loaded, capped]).then(() => root.classList.remove(PENDING));
      });
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
