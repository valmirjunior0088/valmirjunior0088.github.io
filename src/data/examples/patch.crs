use /std/{Fmt, Nat, List};

pub struct Point: pub Type {
    x: Nat,
    y: Nat,
}

let p: Point =
    Point { x = 1, y = 2 };

let q: Point =
    Point { ..p, y = 9 };

let base: List(Nat) =
    [2, 3, 4];

let padded: List(Nat) =
    [1, ..base, 5];

Fmt/print("q = (%, %), padded has % elems\n")(q.x)(q.y)(List/len(padded))
