use /std/{Fmt, Nat, Spell};
use /std/ops/{Add};

pub struct Point: pub Type {
    x: Nat,
    y: Nat,
}

satisfy Add(Point) {
    add(a, b) = Point { x = a.x + b.x, y = a.y + b.y },
}

satisfy Spell(Point) {
    ..
}

let p: Point =
    Point { x = 1, y = 2 } + Point { x = 3, y = 4 };

Fmt/print("p = #\n")(p)
