---
import CodeCard from "./CodeCard.astro";
import { EXAMPLES, type CuriosExample } from "../data/examples";

// The curios playground widget: example tabs + a code-card editor that
// compiles/runs via /curios/loader.js. Two variants share this component:
//   - "full"    the standalone /curios/playground page — editable textarea,
//               reset button, structured run output with a wasm download link.
//   - "preview" the homepage teaser — read-only code, no reset, plain-text
//               run summary. Shows a curated subset of examples.
interface Props {
  variant: "full" | "preview";
  exampleKeys?: string[];
  preload?: boolean;
}

const { variant, exampleKeys = Object.keys(EXAMPLES), preload = false } = Astro.props;

const examples: Record<string, CuriosExample> = Object.fromEntries(
  exampleKeys.map((key) => [key, EXAMPLES[key]])
);
const defaultKey = exampleKeys[0];

const widgetId = variant === "full" ? "editor-full" : "editor-preview";
---

{preload && <script type="module" is:inline src="/curios/loader.js"></script>}

<div id={widgetId} class="editor-widget" data-variant={variant}>
  <div class="tabs">
    {
      exampleKeys.map((key) => (
        <button class="tab" data-example={key}>
          {examples[key].tab}
        </button>
      ))
    }
  </div>

  <CodeCard>
    <Fragment slot="topbar-extra">
      <span class="chip filename">{examples[defaultKey].label}</span>
    </Fragment>
    <Fragment slot="actions">
      {variant === "full" && <span class="status" aria-live="polite" />}
      {variant === "full" && (
        <button class="btn btn-outline btn-reset">
          Reset
        </button>
      )}
      <button class="btn btn-primary btn-run">
        Run &#9654;
      </button>
    </Fragment>

    {
      variant === "full" ? (
        <div class="editor">
          <div class="gutter" />
          <textarea class="editor-input" spellcheck="false" />
        </div>
      ) : (
        <div class="preview-editor">
          <div class="gutter" />
          <pre class="preview-code" />
        </div>
      )
    }

    <div class="output" hidden aria-live="polite" />
  </CodeCard>
</div>

<script type="module" define:vars={{ variant, examples, defaultKey, widgetId }}>
  import { compileAndReport } from "/curios/loader.js";

  // Elements are looked up by the classes each already carries for styling
  // (rather than parallel id maps per variant) — safe because only one
  // variant of this widget is ever mounted on a given page.
  const widget = document.getElementById(widgetId);
  const el = {
    tabs: widget.querySelectorAll(".tab"),
    filename: widget.querySelector(".filename"),
    run: widget.querySelector(".btn-run"),
    gutter: widget.querySelector(".gutter"),
    output: widget.querySelector(".output"),
    ...(variant === "full"
      ? {
          status: widget.querySelector(".status"),
          reset: widget.querySelector(".btn-reset"),
          editor: widget.querySelector(".editor-input"),
        }
      : { code: widget.querySelector(".preview-code") }),
  };

  let active = defaultKey;
  let running = false;
  let downloadUrl = null;

  // No-op in "preview" (which has no status chip) so call sites don't need
  // their own variant check.
  const setStatus = variant === "full" ? (text) => (el.status.textContent = text) : () => {};

  function revokeDownload() {
    if (downloadUrl) {
      URL.revokeObjectURL(downloadUrl);
      downloadUrl = null;
    }
  }

  function renderGutter(code) {
    const lines = code.split("\n").length;
    el.gutter.innerHTML = "";
    for (let i = 1; i <= lines; i++) {
      const row = document.createElement("div");
      row.textContent = String(i);
      el.gutter.appendChild(row);
    }
  }

  function autosize() {
    el.editor.style.height = "auto";
    const height = Math.max(340, el.editor.scrollHeight);
    el.editor.style.height = height + "px";
    el.gutter.style.height = height + "px";
  }

  function formatSummary(result) {
    return `✓ typechecked in ${result.typeMs.toFixed(1)}ms · compiled to wasm in ${result.wasmMs.toFixed(1)}ms (${result.bytes.length} bytes)`;
  }

  function renderFullSuccess(result) {
    downloadUrl = URL.createObjectURL(new Blob([result.bytes], { type: "application/wasm" }));
    el.output.innerHTML = "";
    const line1 = document.createElement("div");
    line1.textContent = formatSummary(result);
    el.output.appendChild(line1);

    const { run } = result;
    if (run.stdout || run.stderr || run.trap) {
      const programOutput = document.createElement("pre");
      programOutput.className = "program-output";
      programOutput.textContent = run.stdout + run.stderr;
      el.output.appendChild(programOutput);
    }
    if (run.trap) {
      const trapLine = document.createElement("div");
      trapLine.className = "trap-line";
      trapLine.textContent = `✗ ${run.trap}`;
      el.output.appendChild(trapLine);
    } else if (run.exitCode) {
      const exitLine = document.createElement("div");
      exitLine.textContent = `process exited with code ${run.exitCode}`;
      el.output.appendChild(exitLine);
    }

    const link = document.createElement("a");
    link.href = downloadUrl;
    link.download = (el.filename.textContent || "output.crs").replace(/\.crs$/, ".wasm");
    link.textContent = "Download .wasm →";
    link.className = "download-link";
    el.output.appendChild(link);
    setStatus(run.trap ? "✓ compiled · ✗ run failed" : "✓ compiled & ran");
  }

  function renderPreviewSuccess(result) {
    const summary = formatSummary(result);
    el.output.textContent = result.run.trap
      ? `${summary}\n✗ ${result.run.trap}`
      : `${summary}\n${result.run.stdout}${result.run.stderr}`.trimEnd();
  }

  // Everything that differs between the two variants lives in one of these
  // two objects — the tab/gutter/run-button plumbing below is
  // variant-agnostic and just calls into `strategy`.
  const strategies = {
    full: {
      init() {
        el.editor.addEventListener("input", () => {
          el.tabs.forEach((btn) => btn.classList.remove("tab-active"));
          el.filename.textContent = "";
          el.filename.hidden = true;
          renderGutter(el.editor.value);
          autosize();
        });
        el.reset.addEventListener("click", () => setActiveTab(active));
      },
      showExample(example) {
        el.editor.value = example.code;
        el.filename.hidden = false;
        setStatus("");
        autosize();
      },
      sourceCode: () => el.editor.value,
      beforeRun: revokeDownload,
      onSuccess: renderFullSuccess,
    },
    preview: {
      init() {},
      showExample(example) {
        el.code.textContent = example.code;
      },
      sourceCode: () => examples[active].code,
      beforeRun() {
        el.output.hidden = true;
      },
      onSuccess: renderPreviewSuccess,
    },
  };
  const strategy = strategies[variant];

  function setActiveTab(key) {
    revokeDownload();
    active = key;
    const example = examples[key];
    el.filename.textContent = example.label;
    el.output.hidden = true;
    el.tabs.forEach((btn) => btn.classList.toggle("tab-active", btn.dataset.example === key));
    renderGutter(example.code);
    strategy.showExample(example);
  }

  el.tabs.forEach((btn) => {
    btn.addEventListener("click", () => setActiveTab(btn.dataset.example));
  });
  strategy.init();

  el.run.addEventListener("click", async () => {
    if (running) return;
    running = true;
    el.run.disabled = true;
    el.run.textContent = "Running…";
    strategy.beforeRun();
    setStatus("compiling…");

    const result = await compileAndReport(strategy.sourceCode());

    el.output.hidden = false;
    if (result.ok) {
      el.output.className = "output ok-output";
      strategy.onSuccess(result);
    } else {
      el.output.className = "output err-output";
      el.output.textContent = result.error;
      setStatus(result.phase === "typecheck" ? "✗ type error" : "✗ compile error");
    }

    running = false;
    el.run.disabled = false;
    el.run.textContent = "Run again ▶";
  });

  setActiveTab(defaultKey);
</script>

<style>
  .tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .tab {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-dimmer);
  }
  .tab-active {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--fg);
  }

  .btn-run {
    font-size: 13px;
    padding: 8px 18px;
  }
  .btn-reset {
    font-size: 13px;
    padding: 8px 14px;
  }

  .status {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-faint);
  }

  .gutter {
    flex-shrink: 0;
    box-sizing: border-box;
    text-align: right;
    font-family: var(--mono);
    color: var(--fg-fainter);
    user-select: none;
  }

  .editor-widget[data-variant="full"] .gutter {
    width: 52px;
    padding: 20px 8px 20px 16px;
    font-size: 14.5px;
    line-height: 1.7;
    border-right: 1px solid var(--border-soft);
  }
  .editor-widget[data-variant="full"] .editor {
    display: flex;
    align-items: flex-start;
    min-height: 340px;
  }
  .editor-widget[data-variant="full"] .editor-input {
    flex: 1;
    box-sizing: border-box;
    min-height: 340px;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    color: oklch(94% 0.006 285);
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.7;
    padding: 20px 24px;
    overflow: hidden;
  }

  .editor-widget[data-variant="preview"] .gutter {
    width: 38px;
    font-size: 15px;
    line-height: 1.9;
    padding-right: 14px;
    border-right: 1px solid var(--border-soft);
  }
  .editor-widget[data-variant="preview"] .preview-editor {
    display: flex;
    padding: 22px 0;
  }
  .editor-widget[data-variant="preview"] .preview-code {
    flex: 1;
    margin: 0;
    padding: 0 24px;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.9;
    white-space: pre;
    color: var(--fg);
    overflow-x: auto;
  }

  .output {
    border-top: 1px solid var(--border-soft);
    background: var(--bg-output);
    padding: 20px 28px;
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.8;
    white-space: pre-wrap;
  }
  .ok-output {
    color: var(--fg-faint);
  }
  .err-output {
    color: var(--red);
  }
  .download-link {
    display: block;
    margin-top: 10px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .program-output {
    margin: 12px 0;
    padding: 12px 14px;
    background: var(--bg-card-alt);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    color: var(--fg);
    white-space: pre-wrap;
    font: inherit;
  }
  .trap-line {
    color: var(--red);
    margin-bottom: 6px;
  }
</style>
