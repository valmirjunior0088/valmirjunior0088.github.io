---
// The most reused box on the site. The hero's code panels and every cheatsheet card are the same three-register box — an optional head strip, a body, an optional foot strip — differing only in what gets slotted in.
import styles from "./Panel.module.css";

interface Props {
  class?: string;
  // Anything else passed in lands on the box itself, which is how a consumer hangs its own data attributes on a panel without this component knowing about them.
  [key: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;

const hasHead = Astro.slots.has("head");
const hasFoot = Astro.slots.has("foot");
---

<div class:list={[styles.panel, className]} {...attrs}>
  {
    hasHead && (
      <div class={styles.head}>
        <slot name="head" />
      </div>
    )
  }
  <slot />
  {
    hasFoot && (
      <div class={styles.foot}>
        <slot name="foot" />
      </div>
    )
  }
</div>
