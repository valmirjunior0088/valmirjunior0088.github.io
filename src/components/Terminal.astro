---
// Something the compiler printed, set as a terminal would show it — terminal-like rather than a working terminal. The command that produced it rides in a status bar across the top, the way the playground's action bar sits over its output pane, and the output below is in the terminal's roles (src/lib/terminal.ts), with nothing after it.
import { terminal } from "../lib/terminal";
import styles from "./Terminal.module.css";

interface Props {
  command: string;
  output: string;
}

const { command, output } = Astro.props;
---

<figure class:list={[terminal.terminal, styles.window]}>
  <figcaption class={styles.status}>{command}</figcaption>
  <pre class={styles.output} set:html={output} />
</figure>
