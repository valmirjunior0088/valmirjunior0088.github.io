---
// Something the compiler printed, set as a terminal would show it — terminal-like rather than a working terminal. The command that produced it rides in a status bar across the top, like the file name over the code panel beside it, and the output below is in the terminal's roles (src/lib/terminal.ts), with nothing after it.
import StatusBar from "./StatusBar.astro";
import { terminal } from "../lib/terminal";
import styles from "./Terminal.module.css";

interface Props {
  command: string;
  output: string;
}

const { command, output } = Astro.props;
---

<figure class:list={[terminal.terminal, styles.window]}>
  <StatusBar as="figcaption">{command}</StatusBar>
  <pre class={styles.output} set:html={output} />
</figure>
