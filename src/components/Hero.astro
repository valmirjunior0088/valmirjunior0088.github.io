---
import Section from "./Section.astro";
import Panel from "./Panel.astro";
import Label from "./Label.astro";
import Button from "./Button.astro";
import Code from "./Code.astro";
import InstallBox from "./InstallBox.astro";
import Wordmark from "./Wordmark.astro";
import { HERO } from "../data/home";
import { PAGES, BUILD_URL } from "../data/site";
import styles from "./Hero.module.css";
---

<Section>
  <div class={styles.hero}>
    <div class={styles.col}>
      <div class={styles.lockup}>
        <Wordmark width={198} />
      </div>
      <Label as="p" class={styles.eyebrow}>{HERO.eyebrow}</Label>
      <h1 class={styles.heading} set:html={HERO.heading.join("<br>")} />
      <p class={styles.lead}>{HERO.lead}</p>
      <div class={styles.actions}>
        <Button variant="primary" href={PAGES.playground.href} class={styles.primary}>Argue with it in a browser tab</Button>
        <Button variant="outline" href={BUILD_URL} class={styles.secondary}>Build it yourself</Button>
      </div>
      <InstallBox />
    </div>

    <div class:list={[styles.col, styles.panels]}>
      <Panel>
        <Code html={HERO.declaration.join("\n")} class={styles.file} />
      </Panel>

      <Panel>
        <Code html={HERO.usage.join("\n")} class={styles.file} />
      </Panel>

      <Panel tone="accent">
        <Code html={HERO.diagnostic.join("\n")} class={styles.diagnostic} />
      </Panel>
    </div>
  </div>
</Section>
