---
import Button from "./Button.astro";
import Label from "./Label.astro";
import { INSTALL_COMMAND } from "../data/site";
import styles from "./InstallBox.module.css";
---

<div class={styles.install}>
  <Label class={styles.caption}>INSTALL THE CLI</Label>
  <div class={styles.well}>
    <code class={styles.command} data-install-command>{INSTALL_COMMAND}</code>
    <Button variant="chip" class={styles.copy} data-install-copy>COPY</Button>
  </div>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-install-copy]");
  const command = document.querySelector<HTMLElement>("[data-install-command]");

  if (button && command) {
    // A one-pixel slack, because a scroller at its end can land a fraction short of its own scrollWidth.
    const atEnd = () => command.scrollWidth - command.scrollLeft - command.clientWidth <= 1;
    const syncFade = () => command.toggleAttribute("data-ended", atEnd());

    command.addEventListener("scroll", syncFade, { passive: true });
    window.addEventListener("resize", syncFade);
    syncFade();
    // Measured once more when the web fonts land: the command is drawn in a fallback face until then, and the swap changes how wide it runs without changing the box it scrolls in, so nothing else would notice.
    document.fonts.ready.then(syncFade);

    let revert: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? "");
        button.textContent = "COPIED";
      } catch {
        // Clipboard access can be refused outright — an insecure origin, a permissions policy, a browser that simply says no. Saying so is more use than a button that silently pretends it worked.
        button.textContent = "COPY FAILED";
      }
      clearTimeout(revert);
      revert = setTimeout(() => (button.textContent = "COPY"), 1600);
    });
  }
</script>
