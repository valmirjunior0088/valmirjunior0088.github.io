---
import Label from "./Label.astro";
import { ISSUES_URL, LICENCE } from "../data/site";
import styles from "./Footer.module.css";
---

<footer class={styles.footer}>
  <img class={styles.mark} src="/curios/brand/curios-mark.svg" alt="" width="18" height="19" />
  <Label>CURIOS · {LICENCE}</Label>
  <a class={styles.link} href={ISSUES_URL}>Report something surprising →</a>
</footer>
