---
import { ISSUES_URL } from "../data/site";
---

<footer>
  <img src="/curios/brand/curios-mark.svg" alt="" width="18" height="19" />
  <span class="label">CURIOS · APACHE-2.0</span>
  <a href={ISSUES_URL}>Report something surprising →</a>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px var(--pad);
    border-top: 1px solid var(--edge);
  }

  img {
    display: block;
  }

  a {
    margin-left: auto;
    font-size: 13px;
  }

  /* Two rows on a phone, both centred: the mark and its label, then the link. */
  @media (max-width: 720px) {
    footer {
      justify-content: center;
    }

    a {
      margin-left: 0;
      flex-basis: 100%;
      text-align: center;
    }
  }
</style>
