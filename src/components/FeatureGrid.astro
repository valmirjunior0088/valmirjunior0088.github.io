---
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import HairlineGrid from "./HairlineGrid.astro";
import Label from "./Label.astro";
import { FEATURES } from "../data/home";
import { inlineCode } from "../lib/inline";
import styles from "./FeatureGrid.module.css";
---

<Section banded>
  <div class={styles.head}>
    <SectionTitle>What is actually in the box</SectionTitle>
    <Label>SHIPPED, NOT PLANNED</Label>
  </div>

  <HairlineGrid>
    {
      FEATURES.map((feature) => (
        <div class={styles.cell}>
          <Label tone="accent" class={styles.kicker}>{feature.kicker}</Label>
          <p set:html={inlineCode(feature.body)} />
        </div>
      ))
    }
  </HairlineGrid>
</Section>
