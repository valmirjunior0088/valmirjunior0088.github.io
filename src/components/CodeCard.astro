---
interface Props {
  filename?: string;
}

const { filename } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<div class="code-card">
  <div class="code-card-topbar" class:list={{ "code-card-topbar-split": hasActions }}>
    <div class="code-card-topbar-left">
      <div class="code-card-dots" aria-hidden="true">
        <div class="code-card-dot"></div>
        <div class="code-card-dot"></div>
        <div class="code-card-dot"></div>
      </div>
      {filename && <span class="code-card-filename">{filename}</span>}
      <slot name="topbar-extra" />
    </div>
    {
      hasActions && (
        <div class="code-card-topbar-right">
          <slot name="actions" />
        </div>
      )
    }
  </div>
  <slot />
</div>

<style>
  .code-card-topbar-split {
    justify-content: space-between;
  }
  .code-card-topbar-left,
  .code-card-topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .code-card-dots {
    display: flex;
    gap: 8px;
  }
</style>
