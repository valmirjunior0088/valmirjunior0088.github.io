---
import CheatsheetCard from "./CheatsheetCard.astro";
import Label from "./Label.astro";
import Button from "./Button.astro";
import { CHEATSHEET } from "../data/cheatsheet";
import { LANGUAGE_URL } from "../data/site";
import styles from "./CheatsheetRail.module.css";
---

<div class={styles.backdrop} data-rail-backdrop hidden></div>

<aside class={styles.rail} data-rail aria-label="Cheatsheet" aria-hidden="true" inert>
  <div class={styles.head}>
    <div class={styles.row}>
      <h2 class={styles.title}>Cheatsheet</h2>
      <div class={styles.field}>
        <input
          class={styles.search}
          type="search"
          placeholder="Search…"
          aria-label="Search the cheatsheet"
          autocomplete="off"
          data-rail-search
        />
        <Label class={styles.count} data-rail-count />
      </div>
      <Button variant="chip" class={styles.close} data-rail-close title="Close the cheatsheet" aria-label="Close the cheatsheet">›</Button>
    </div>
  </div>

  <div class={styles.body}>
    <div class={styles.cards} data-rail-cards>
      {CHEATSHEET.map((card) => <CheatsheetCard card={card} />)}
    </div>

    <p class={styles.empty} hidden data-rail-empty>
      no matches for &ldquo;<span data-rail-query></span>&rdquo; &mdash;
      <button class={styles.reset} data-rail-reset>clear the filter</button>
    </p>

    <a class={styles.reference} href={LANGUAGE_URL}>Full language reference →</a>
  </div>
</aside>

<script>
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const backdrop = document.querySelector<HTMLElement>("[data-rail-backdrop]");
  const search = document.querySelector<HTMLInputElement>("[data-rail-search]");
  const empty = document.querySelector<HTMLElement>("[data-rail-empty]");
  const query = document.querySelector<HTMLElement>("[data-rail-query]");
  const counter = document.querySelector<HTMLElement>("[data-rail-count]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
  const toggles = [...document.querySelectorAll<HTMLElement>("[data-rail-toggle]")];
  const closers = [...document.querySelectorAll<HTMLElement>("[data-rail-close]")];

  if (rail && backdrop && search && empty && query) {
    // What opened the rail, so closing it can hand the focus back rather than dropping it at the top of the document.
    let opener: HTMLElement | null = null;

    // A closed rail is off-screen, not gone: its field, its buttons, and its link stay in the tab order, and aria-hidden over focusable content is both an ARIA violation and, in practice, a tab that lands somewhere invisible. `inert` is what actually puts them out of reach — and it is on the markup from the start, since a rail nothing has opened cannot be used anyway. It is also the one fact the style reads to slide the rail in, so being open and being drawn open cannot disagree.
    const setOpen = (open: boolean) => {
      rail.setAttribute("aria-hidden", String(!open));
      rail.inert = !open;
      backdrop.hidden = !open;
      if (open) search.focus();
      else opener?.focus();
    };

    const filter = () => {
      const needle = search.value.trim().toLowerCase();
      let matches = 0;

      for (const card of cards) {
        const hit = !needle || (card.dataset.search ?? "").includes(needle);
        card.hidden = !hit;
        if (hit) matches++;
      }

      empty.hidden = matches > 0;
      query.textContent = search.value.trim();

      // Silent while unfiltered — the full count is the resting state and needs no announcing; it earns its place only once a search has narrowed things.
      if (counter) counter.textContent = needle ? `${matches} of ${cards.length}` : "";
    };

    toggles.forEach((toggle) =>
      toggle.addEventListener("click", () => {
        opener = toggle;
        setOpen(rail.inert);
      }),
    );
    closers.forEach((closer) => closer.addEventListener("click", () => setOpen(false)));
    backdrop.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !rail.inert) setOpen(false);
    });

    search.addEventListener("input", filter);

    document.querySelector<HTMLElement>("[data-rail-reset]")?.addEventListener("click", () => {
      search.value = "";
      filter();
      search.focus();
    });
  }
</script>
