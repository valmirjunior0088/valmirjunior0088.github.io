---
import Panel from "./Panel.astro";
import Label from "./Label.astro";
import Code from "./Code.astro";
import { inlineCode } from "../lib/inline";
import type { CheatsheetCard } from "../data/cheatsheet";
import styles from "./CheatsheetCard.module.css";

interface Props {
  card: CheatsheetCard;
}

const { card } = Astro.props;

// Everything a card says is searchable, not just its title — filtering on the code is how you find `..p` when you cannot remember it is called a spread. Precomputed, so a keystroke costs one substring test.
const haystack = [card.title, card.tag, card.code.flat().join(" "), card.gloss].join(" ").toLowerCase();
---

<Panel class={styles.card} data-card data-search={haystack}>
  <Fragment slot="head">
    <span class={styles.title}>{card.title}</span>
    <Label size="sm" tone="accent" class={styles.tag}>{card.tag}</Label>
  </Fragment>

  <div class={styles.well}>
    {
      card.code.map((example) => (
        <div class={styles.example}>
          <Code code={example.join("\n")} size="sm" />
        </div>
      ))
    }
  </div>

  <Fragment slot="foot">
    <span class={styles.gloss} set:html={inlineCode(card.gloss)} />
  </Fragment>
</Panel>
