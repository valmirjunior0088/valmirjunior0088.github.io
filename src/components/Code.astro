---
// A block of Curios, highlighted by the compiler's own grammar at build time (src/lib/highlight.ts). `size="sm"` is the cheatsheet's step down the scale, which also wraps a long line where a block elsewhere would scroll.
import { highlight } from "../lib/highlight";
import styles from "./Code.module.css";

interface Props {
  code: string;
  size?: "sm";
  class?: string;
}

const { code, size, class: className } = Astro.props;
---

<pre class:list={[styles.code, size === "sm" && styles.sm, className]} set:html={highlight(code)} />
