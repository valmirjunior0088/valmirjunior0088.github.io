---
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import Chip from "./Chip.astro";
import { RESOURCES, CLOSING } from "../data/home";
import { LICENCE } from "../data/site";
import styles from "./ResourceGrid.module.css";
---

<Section>
  <div class={styles.closing}>
    <div>
      <SectionTitle class={styles.heading}>{CLOSING.heading}</SectionTitle>
      <p>{CLOSING.body}</p>
      <Chip static class={styles.licence}>{LICENCE}</Chip>
    </div>

    <div class={styles.cards}>
      {
        RESOURCES.map((resource) => (
          <a class={styles.card} href={resource.href}>
            <span class={styles.title}>{resource.title}</span>
            <span class={styles.body}>{resource.body}</span>
          </a>
        ))
      }
    </div>
  </div>
</Section>
