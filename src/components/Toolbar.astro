---
// A fixed-height strip across the playground: the example picker, the action bar. Never grows, never scrolls vertically, and separates two flexible regions.
interface Props {
  scroll?: boolean;
  class?: string;
}

const { scroll = false, class: className } = Astro.props;
---

<div class:list={["toolbar", scroll && "toolbar--scroll", className]}>
  <slot />
</div>

<style>
  .toolbar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    background: var(--band);
    border-bottom: 1px solid var(--line);
  }

  /* The example picker can outgrow the width; it scrolls sideways rather than wrapping into a second row and changing the frame's geometry. */
  .toolbar--scroll {
    overflow-x: auto;
  }

  .toolbar--scroll > :global(*) {
    flex: none;
  }
</style>
