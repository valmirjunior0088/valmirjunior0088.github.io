---
import Wordmark from "./Wordmark.astro";
import Label from "./Label.astro";
import { PAGES, EXTERNAL_NAV, type PageId } from "../data/site";
import { inlineCode } from "../lib/inline";
import styles from "./Header.module.css";

interface Props {
  current: PageId;
}

const { current } = Astro.props;

const page = PAGES[current];

// Whichever page you are on becomes the chip beside the wordmark, so listing it again in the nav would only offer you a link to where you already are.
const internal = (Object.keys(PAGES) as PageId[])
  .filter((id) => id !== current)
  .map((id) => ({ label: PAGES[id].label, href: PAGES[id].href }));

const links = [...internal, ...EXTERNAL_NAV];
---

<header class={styles.bar}>
  <a href={PAGES.home.href} class={styles.brand}>
    <Wordmark class={styles.wordmark} />
    <img class={styles.mark} src="/curios/brand/curios-mark.svg" alt="Curios" width="30" height="32" />
  </a>
  <Label class={styles.crumb}>{page.chip}</Label>
  <nav class={styles.nav}>
    {links.map((link) => <a href={link.href} set:html={inlineCode(link.label)} />)}
  </nav>
</header>
