---
import Wordmark from "./Wordmark.astro";
import { PAGES, EXTERNAL_NAV, type PageId } from "../data/site";
import { inlineCode } from "../data/markup";

interface Props {
  current: PageId;
  sticky?: boolean;
}

const { current, sticky = false } = Astro.props;

const page = PAGES[current];

// Whichever page you are on becomes the chip beside the wordmark, so listing it again in the nav would only offer you a link to where you already are.
const internal = (Object.keys(PAGES) as PageId[])
  .filter((id) => id !== current)
  .map((id) => ({ label: PAGES[id].label, href: PAGES[id].href }));

const links = [...internal, ...EXTERNAL_NAV];
---

<header class:list={["bar", sticky && "bar--sticky"]}>
  <a href={PAGES.home.href} class="brand">
    <Wordmark />
    <img class="mark" src="/curios/brand/curios-mark.svg" alt="Curios" width="30" height="32" />
  </a>
  <span class="label crumb">{page.chip}</span>
  <nav>
    {links.map((link) => <a href={link.href} set:html={inlineCode(link.label)} />)}
  </nav>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--bar);
    padding: 0 28px;
    border-bottom: 1px solid var(--edge);
  }

  /* Both pages hold the bar in place and blur what passes under it. On a wide screen the playground's frame never scrolls, so this is inert there; on a phone the frame becomes a scrolling document and the bar behaves exactly as it does on the landing page. */
  .bar--sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(20, 51, 64, 0.88);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand .mark {
    display: none;
  }

  .crumb {
    padding-left: 20px;
    border-left: 1px solid var(--edge-strong);
  }

  nav {
    display: flex;
    gap: 24px;
    min-width: 0;
    margin-left: auto;
    font-size: 14px;
  }

  nav a {
    flex: none;
    color: var(--fg-body);
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--accent);
  }

  /* A label may carry a code span — "/std docs" names a path — and it wears the link's own colour rather than the accent the class would give it: amber is what this bar means by "hovered", and a link that is half amber at rest would be claiming a hover it does not have. The mono face runs larger than Geist at the same size, so it steps down a notch to sit on the same line. */
  nav a :global(code) {
    color: inherit;
    font-size: 0.92em;
  }

  /* The bar keeps its height at every width — the cheatsheet rail's title row is drawn to it — so nothing here may wrap. The crumb goes first: it only restates which page you are on, which the nav already implies by omission. */
  @media (max-width: 720px) {
    .bar {
      gap: 16px;
      padding: 0 var(--pad);
    }

    .crumb {
      display: none;
    }

    /* Four links do not fit beside the mark on the narrowest phones, and the bar may neither wrap nor grow — so the nav scrolls sideways, as the example picker does, with the scrollbar hidden the way the install command hides its own. The row starts flush right, so what a narrow screen loses is the far end of a scroller and never a link you cannot reach. */
    nav {
      gap: 16px;
      font-size: 13px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }
  }

  /* Tighter still on the narrowest phones, so that the last link is at least cut at the edge rather than gone from it: a word half shown says there is more, where a bar that ends cleanly on "/std docs" says nothing about GitHub. */
  @media (max-width: 400px) {
    nav {
      gap: 12px;
      font-size: 12px;
    }

    /* The wordmark gives way to the mark: the row is short of room, and a monogram beside three links reads as a mobile header rather than a desktop one squeezed. It is drawn at 30×32 rather than the wordmark's 26px of height — a monogram alone in the corner can carry more weight than one standing next to its own name, and the bar has 56px to spend. The box follows the artwork's 18:19, so nothing is stretched to get there. */
    .brand :global(.wordmark) {
      display: none;
    }

    .brand .mark {
      display: block;
    }
  }
</style>
