---
interface Props {
  name: string;
  label: string;
  placeholder: string;
  count?: boolean;
}

const { name, label, placeholder, count = false } = Astro.props;
---

<section class="pane" data-pane={name}>
  <div class="head">
    <span class="label">{label}</span>
    {count && <span class="label label--sm count" data-count />}
    <button class="btn btn--chip push" data-clear={name}>CLEAR</button>
  </div>
  <pre class="body empty" data-body data-placeholder={placeholder} aria-live="polite">{placeholder}</pre>
</section>

<style>
  .pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .pane[data-pane="diagnostics"] {
    border-right: 1px solid var(--edge);
  }

  .head {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .count[data-tone="ok"] {
    color: var(--ok);
  }

  .count[data-tone="error"] {
    color: var(--err);
  }

  .body {
    flex: 1;
    margin: 0;
    padding: 16px;
    overflow: auto;
    font-family: var(--mono);
    font-size: var(--ms-code-sm);
    line-height: 1.75;
    white-space: pre-wrap;
    color: var(--fg-code);
  }

  /* The placeholder is prose, not output, and says so by sitting a tier dimmer than anything the compiler actually printed. */
  .body.empty {
    color: var(--fg-mute);
  }

  .body.error {
    color: var(--err);
  }
</style>
